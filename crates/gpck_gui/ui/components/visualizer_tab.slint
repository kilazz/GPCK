// ui/components/visualizer_tab.slint
import {
    VerticalBox,
    HorizontalBox,
    ScrollView,
    CheckBox,
} from "std-widgets.slint";
import { Theme } from "theme.slint";

export struct BlockItemUI {
    width: length,
    color_algo: color,
    color_part: color,
    tooltip: string,
}

// Reusable, optically aligned legend badge component
component LegendBadge inherits HorizontalLayout {
    in property <color> badge_color;
    in property <string> label;

    spacing: 5px;
    alignment: center;

    // Optical centering container matching the 14px font line height
    Rectangle {
        width: 10px;
        height: 14px;

        Rectangle {
            y: 2px; // Optical nudge: aligns square with capital letter cap-height
            width: 10px;
            height: 10px;
            border-radius: 2px;
            background: root.badge_color;
        }
    }

    Text {
        text: root.label;
        color: #cccccc;
        font-size: 11px;
        vertical-alignment: center;
    }
}

export component VisualizerTab inherits Rectangle {
    background: #222222;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.card_border;

    in-out property <[BlockItemUI]> visualizer_blocks: [];
    in-out property <int> selected_file_index: -1;
    in-out property <bool> map_color_by_partition: false;

    callback block_clicked(int);

    VerticalBox {
        padding: 12px;
        spacing: 10px;

        // Top Header & Legend Bar
        HorizontalLayout {
            spacing: 14px;
            height: 24px;
            alignment: center;

            Text {
                text: "Archive Layout Map (Click block to select)";
                font-weight: 700;
                font-size: 13px;
                color: #ffffff;
                vertical-alignment: center;
            }

            Rectangle {
                width: 4px;
            } // Spacer after title

            // Optically Centered Legend Badges
            LegendBadge {
                badge_color: #81c784;
                label: "GDeflate";
            }

            LegendBadge {
                badge_color: #90caf9;
                label: "ZSTD";
            }

            LegendBadge {
                badge_color: #ffb74d;
                label: "LZ4";
            }

            LegendBadge {
                badge_color: #ab47bc;
                label: "rANS";
            }

            LegendBadge {
                badge_color: #cfd8dc;
                label: "Store";
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            CheckBox {
                text: "Color by NVMe Partition";
                checked <=> root.map_color_by_partition;
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.card_border;
        }

        ScrollView {
            VerticalBox {
                alignment: start;
                padding: 0px;
                spacing: 0px;
                HorizontalLayout {
                    spacing: 1px;
                    padding: 0px;
                    for block[idx] in root.visualizer_blocks: TouchArea {
                        width: block.width;
                        height: 38px;
                        clicked => { root.block_clicked(idx); }

                        Rectangle {
                            width: 100%;
                            height: 100%;
                            background: root.selected_file_index == idx ? #ffffff : (root.map_color_by_partition ? block.color_part : block.color_algo);
                            border-width: root.selected_file_index == idx ? 2px : 1px;
                            border-color: root.selected_file_index == idx ? #00e5ff : #181818;
                        }
                    }
                }
            }
        }
    }
}
