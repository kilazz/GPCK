// ui/settings_tab.slint
import {
    Button,
    CheckBox,
    ComboBox,
    LineEdit,
    Slider,
    ScrollView,
} from "std-widgets.slint";

component Card inherits Rectangle {
    in property <string> title;
    in property <color> header-color: #60A5FA;

    background: #1E1E24;
    border-radius: 6px;
    border-width: 1px;
    border-color: #2D2D38;

    VerticalLayout {
        padding: 14px;
        spacing: 12px;

        HorizontalLayout {
            alignment: space-between;
            Text {
                text: root.title;
                font-size: 12px;
                font-weight: 700;
                color: root.header-color;
            }
        }

        @children
    }
}

export component SettingsTab inherits ScrollView {
    in-out property <int> preset-index: 0;
    in-out property <int> method-index: 0;
    in-out property <int> compression-level: 9;
    in-out property <int> partition-size-index: 1;
    in-out property <bool> enable-deduplication: true;
    in-out property <bool> validate-chunks: true;
    in-out property <bool> atg-profile: true;

    // GACL Settings
    in-out property <bool> gacl-auto-mode: true;
    in-out property <int> gacl-bc1-index: 0;
    in-out property <int> gacl-bc2-index: 0;
    in-out property <int> gacl-bc3-index: 0;
    in-out property <int> gacl-bc4-index: 0;
    in-out property <int> gacl-bc5-index: 0;
    in-out property <int> gacl-bc6h-index: 0;
    in-out property <int> gacl-bc7-index: 0;

    // RDO & Format Filters
    in-out property <bool> rdo-enabled: false;
    in-out property <float> rdo-reduction-pct: 5.0;
    in-out property <bool> rdo-use-ycocg: true;
    in-out property <bool> rdo-bc1: true;
    in-out property <bool> rdo-bc2: true;
    in-out property <bool> rdo-bc3: true;
    in-out property <bool> rdo-bc4: false;
    in-out property <bool> rdo-bc5: false;
    in-out property <bool> rdo-bc6h: false;
    in-out property <bool> rdo-bc7: true;

    // Texture Streaming
    in-out property <bool> mip-split-enabled: true;
    in-out property <int> max-tail-res-index: 1;

    // GPU Hardware Acceleration
    in-out property <bool> prefer-gpu-decompression: true;
    in-out property <int> staging-buffer-size-index: 2;
    in-out property <int> default-queue-priority-index: 0;

    // Encryption
    in-out property <string> encryption-key: "";

    // Callbacks
    callback preset-selected(int);
    callback run-bench-clicked();
    callback run-custom-bench-clicked();

    VerticalLayout {
        padding: 16px;
        spacing: 14px;

        // Preset Selector Bar
        Rectangle {
            background: #1E1E24;
            border-radius: 6px;
            border-width: 1px;
            border-color: #3B82F6;
            height: 48px;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                alignment: space-between;

                Text {
                    text: "Packaging Preset / Quality Profile:";
                    vertical-alignment: center;
                    font-size: 13px;
                    font-weight: 700;
                    color: #60A5FA;
                }

                ComboBox {
                    width: 380px;
                    model: [
                        "DirectStorage AAA (Optimized)",
                        "Mobile / Android (ASTC + LZ4)",
                        "Maximum Compression (Distribution)",
                        "Fast Dev Build (Iteration)",
                        "Secure Delivery (Encrypted)",
                        "Custom (User Defined)"
                    ];
                    current-index <=> root.preset-index;
                    selected(val) => {
                        root.preset-selected(root.preset-index);
                    }
                }
            }
        }

        // Row 1: Compression & Texture Streaming
        HorizontalLayout {
            spacing: 14px;

            // Compression Card
            Card {
                title: "[COMPRESSION] Archiving & Compression Engine";
                header-color: #60A5FA;
                width: 50%;

                GridLayout {
                    spacing: 10px;
                    Row {
                        Text {
                            text: "Algorithm:";
                            color: #D1D5DB;
                            font-size: 12px;
                            vertical-alignment: center;
                        }

                        ComboBox {
                            model: ["GDeflate", "Zstd", "LZ4", "rANS", "Store"];
                            current-index <=> root.method-index;
                        }
                    }

                    Row {
                        Text {
                            text: "Compression Level:";
                            color: #D1D5DB;
                            font-size: 12px;
                            vertical-alignment: center;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            Slider {
                                minimum: 1;
                                maximum: 22;
                                value <=> root.compression-level;
                            }

                            Text {
                                text: "\{root.compression-level}";
                                color: #FFFFFF;
                                font-size: 12px;
                                vertical-alignment: center;
                                width: 24px;
                            }
                        }
                    }

                    Row {
                        Text {
                            text: "Partition Size (NVMe):";
                            color: #D1D5DB;
                            font-size: 12px;
                            vertical-alignment: center;
                        }

                        ComboBox {
                            model: ["32 MB", "64 MB", "128 MB", "256 MB", "512 MB"];
                            current-index <=> root.partition-size-index;
                        }
                    }
                }

                VerticalLayout {
                    spacing: 6px;
                    CheckBox {
                        text: "Content-Defined Deduplication (XxHash64)";
                        checked <=> root.enable-deduplication;
                    }

                    CheckBox {
                        text: "Validate Chunk Decompression on Pack";
                        checked <=> root.validate-chunks;
                    }

                    CheckBox {
                        text: "Enforce ATG DirectStorage L2/L3 Cache Bounds (256 KB)";
                        checked <=> root.atg-profile;
                    }
                }
            }

            // Streaming Card
            Card {
                title: "[STREAMING] DDS Texture Streaming & Mip-Split";
                header-color: #34D399;
                width: 50%;

                VerticalLayout {
                    spacing: 10px;

                    CheckBox {
                        text: "Split Mipmaps into Streamable .highmips";
                        checked <=> root.mip-split-enabled;
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: "Max Tail Resolution:";
                            color: #D1D5DB;
                            font-size: 12px;
                            vertical-alignment: center;
                        }

                        ComboBox {
                            model: ["64x64", "128x128", "256x256", "512x512"];
                            current-index <=> root.max-tail-res-index;
                            enabled: root.mip-split-enabled;
                        }
                    }

                    Text {
                        text: "Tail mips are placed in Partition 0 (Boot) for instant rendering, while high-res mips stream dynamically on demand.";
                        font-size: 11px;
                        color: #9CA3AF;
                        wrap: word-wrap;
                    }
                }
            }
        }

        // Row 2: GACL Texture Matrix & GPU DirectStorage
        HorizontalLayout {
            spacing: 14px;

            // GACL Matrix Card with RDO & Format Checkboxes
            Card {
                title: "[GACL] Texture Matrix";
                header-color: #F59E0B;
                width: 50%;

                HorizontalLayout {
                    alignment: end;
                    CheckBox {
                        text: "Auto-Optimizer";
                        checked <=> root.gacl-auto-mode;
                    }
                }

                GridLayout {
                    spacing: 8px;
                    Row {
                        Text {
                            text: "BC1:";
                            color: #9CA3AF;
                            font-size: 11px;
                            vertical-alignment: center;
                        }

                        ComboBox {
                            model: [
                                "Auto",
                                "BC1 Linear (v1)",
                                "BC1 Linear + Z-Curve",
                                "BC1 5:6:5 Split (v2)",
                                "BC1 5:6:5 + Z-Curve"
                            ];
                            current-index <=> root.gacl-bc1-index;
                            enabled: !root.gacl-auto-mode;
                        }

                        Text {
                            text: "BC5:";
                            color: #9CA3AF;
                            font-size: 11px;
                            vertical-alignment: center;
                        }

                        ComboBox {
                            model: ["Auto", "BC5 Dual Channel", "BC5 Dual Channel + Z-Curve"];
                            current-index <=> root.gacl-bc5-index;
                            enabled: !root.gacl-auto-mode;
                        }
                    }

                    Row {
                        Text {
                            text: "BC2:";
                            color: #9CA3AF;
                            font-size: 11px;
                            vertical-alignment: center;
                        }

                        ComboBox {
                            model: ["Auto", "BC2 Alpha Nibble Split"];
                            current-index <=> root.gacl-bc2-index;
                            enabled: !root.gacl-auto-mode;
                        }

                        Text {
                            text: "BC6H:";
                            color: #9CA3AF;
                            font-size: 11px;
                            vertical-alignment: center;
                        }

                        ComboBox {
                            model: ["Auto", "BC6H Header/Index Join"];
                            current-index <=> root.gacl-bc6h-index;
                            enabled: !root.gacl-auto-mode;
                        }
                    }

                    Row {
                        Text {
                            text: "BC3:";
                            color: #9CA3AF;
                            font-size: 11px;
                            vertical-alignment: center;
                        }

                        ComboBox {
                            model: [
                                "Auto",
                                "BC3 Linear (v1)",
                                "BC3 Linear + Z-Curve",
                                "BC3 6:6:4 Split (v2)",
                                "BC3 6:6:4 + Z-Curve"
                            ];
                            current-index <=> root.gacl-bc3-index;
                            enabled: !root.gacl-auto-mode;
                        }

                        Text {
                            text: "BC7:";
                            color: #9CA3AF;
                            font-size: 11px;
                            vertical-alignment: center;
                        }

                        ComboBox {
                            model: ["Auto", "BC7 Mode-Split (3-Stream)", "BC7 Mode-Join (24-bit)"];
                            current-index <=> root.gacl-bc7-index;
                            enabled: !root.gacl-auto-mode;
                        }
                    }

                    Row {
                        Text {
                            text: "BC4:";
                            color: #9CA3AF;
                            font-size: 11px;
                            vertical-alignment: center;
                        }

                        ComboBox {
                            model: ["Auto", "BC4 Linear", "BC4 Linear + Z-Curve"];
                            current-index <=> root.gacl-bc4-index;
                            enabled: !root.gacl-auto-mode;
                        }
                    }
                }

                // RDO Section
                Rectangle {
                    background: #18181E;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: #2D2D38;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 8px;

                        HorizontalLayout {
                            spacing: 10px;
                            CheckBox {
                                text: "RDO:";
                                checked <=> root.rdo-enabled;
                            }

                            Slider {
                                minimum: 1;
                                maximum: 50;
                                value <=> root.rdo-reduction-pct;
                                enabled: root.rdo-enabled;
                            }

                            Text {
                                text: "\{round(root.rdo-reduction-pct)}%";
                                color: #FFFFFF;
                                font-size: 12px;
                                vertical-alignment: center;
                                width: 32px;
                            }
                        }

                        // YCoCg Toggle
                        CheckBox {
                            text: "Perceptual YCoCg Metric (Albedo/Color only)";
                            checked <=> root.rdo-use-ycocg;
                            enabled: root.rdo-enabled;
                        }

                        // Per-Format RDO Checkboxes
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: "RDO Formats:";
                                vertical-alignment: center;
                                color: #9CA3AF;
                                font-size: 11px;
                            }

                            CheckBox {
                                text: "BC1";
                                checked <=> root.rdo-bc1;
                                enabled: root.rdo-enabled;
                            }

                            CheckBox {
                                text: "BC2";
                                checked <=> root.rdo-bc2;
                                enabled: root.rdo-enabled;
                            }

                            CheckBox {
                                text: "BC3";
                                checked <=> root.rdo-bc3;
                                enabled: root.rdo-enabled;
                            }

                            CheckBox {
                                text: "BC4";
                                checked <=> root.rdo-bc4;
                                enabled: root.rdo-enabled;
                            }

                            CheckBox {
                                text: "BC5";
                                checked <=> root.rdo-bc5;
                                enabled: root.rdo-enabled;
                            }

                            CheckBox {
                                text: "BC6H";
                                checked <=> root.rdo-bc6h;
                                enabled: root.rdo-enabled;
                            }

                            CheckBox {
                                text: "BC7";
                                checked <=> root.rdo-bc7;
                                enabled: root.rdo-enabled;
                            }
                        }
                    }
                }
            }

            // DirectStorage Card
            Card {
                title: "[GPU] DirectStorage 1.4 & Hardware Offload";
                header-color: #A855F7;
                width: 50%;

                VerticalLayout {
                    spacing: 12px;

                    CheckBox {
                        text: "Direct-to-VRAM GPU Decompression";
                        checked <=> root.prefer-gpu-decompression;
                    }

                    GridLayout {
                        spacing: 10px;
                        Row {
                            Text {
                                text: "Staging Buffer Size:";
                                color: #D1D5DB;
                                font-size: 12px;
                                vertical-alignment: center;
                            }

                            ComboBox {
                                model: ["64 MB", "128 MB", "256 MB", "512 MB"];
                                current-index <=> root.staging-buffer-size-index;
                            }
                        }

                        Row {
                            Text {
                                text: "Default Queue Priority:";
                                color: #D1D5DB;
                                font-size: 12px;
                                vertical-alignment: center;
                            }

                            ComboBox {
                                model: ["Normal", "High", "Low"];
                                current-index <=> root.default-queue-priority-index;
                            }
                        }
                    }

                    Text {
                        text: "DirectStorage bypasses OS page caches and pipes compressed blocks straight into GPU decompression queues.";
                        font-size: 11px;
                        color: #9CA3AF;
                        wrap: word-wrap;
                    }
                }
            }
        }

        // Row 3: Security & Benchmarks
        HorizontalLayout {
            spacing: 14px;

            // Security Card
            Card {
                title: "[SECURITY] Metadata Encryption (AES-256-GCM)";
                header-color: #EF4444;
                width: 50%;

                VerticalLayout {
                    spacing: 10px;

                    HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: "Master Passphrase:";
                            color: #D1D5DB;
                            font-size: 12px;
                            vertical-alignment: center;
                        }

                        LineEdit {
                            placeholder-text: "Leave empty for unencrypted archive";
                            text <=> root.encryption-key;
                        }
                    }

                    Text {
                        text: "Uses PBKDF2-HMAC-SHA256 (100,000 iterations). Encrypts chunk tables and metadata without compromising raw I/O throughput.";
                        font-size: 11px;
                        color: #9CA3AF;
                        wrap: word-wrap;
                    }
                }
            }

            // Benchmark Card
            Card {
                title: "[BENCHMARK] Hardware & Pipeline Diagnostics";
                header-color: #38BDF8;
                width: 50%;

                VerticalLayout {
                    spacing: 10px;

                    Text {
                        text: "Benchmark memory bandwidth, DirectStorage GPU decompression speed, GACL shuffle transformations, and VFS parallel read rates.";
                        font-size: 11px;
                        color: #9CA3AF;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        Button {
                            text: "Run Full Hardware Benchmark";
                            clicked => { root.run-bench-clicked(); }
                        }

                        Button {
                            text: "Run Custom File Benchmark...";
                            clicked => { root.run-custom-bench-clicked(); }
                        }
                    }
                }
            }
        }
    }
}
