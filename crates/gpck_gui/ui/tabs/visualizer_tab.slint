// crates/gpck_gui/ui/tabs/visualizer_tab.slint
import { ScrollView, CheckBox, ComboBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { BlockItemUI } from "../types.slint";
import { LegendBadge } from "../components/widgets.slint";

export component VisualizerTab inherits Rectangle {
    in-out property <[BlockItemUI]> visualizer-blocks: [];
    in-out property <int> selected-block-index: -1;
    in-out property <bool> map-color-by-partition: false;
    in-out property <int> density-mode-index: 0; // 0 = Auto-Fit (Screen), 1 = Micro (8px), 2 = Medium (16px), 3 = Large (28px)

    callback block-clicked(int);

    background: Theme.surface-dark;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.border-subtle;

    map-focus-scope := FocusScope {
        property <int> cols: map-matrix-container.cols;

        key-pressed(event) => {
            if (event.text == Key.LeftArrow) {
                if (root.selected-block-index > 0) {
                    root.selected-block-index -= 1;
                    root.block-clicked(root.selected-block-index);
                }
                return accept;
            }
            if (event.text == Key.RightArrow) {
                if (root.selected-block-index < root.visualizer-blocks.length - 1) {
                    root.selected-block-index += 1;
                    root.block-clicked(root.selected-block-index);
                }
                return accept;
            }
            if (event.text == Key.UpArrow) {
                if (root.selected-block-index >= self.cols) {
                    root.selected-block-index -= self.cols;
                    root.block-clicked(root.selected-block-index);
                }
                return accept;
            }
            if (event.text == Key.DownArrow) {
                if (root.selected-block-index + self.cols < root.visualizer-blocks.length) {
                    root.selected-block-index += self.cols;
                    root.block-clicked(root.selected-block-index);
                } else if (root.selected-block-index < root.visualizer-blocks.length - 1) {
                    root.selected-block-index = root.visualizer-blocks.length - 1;
                    root.block-clicked(root.selected-block-index);
                }
                return accept;
            }
            if (event.text == Key.Home) {
                root.selected-block-index = 0;
                if (root.visualizer-blocks.length > 0) {
                    root.block-clicked(0);
                }
                return accept;
            }
            if (event.text == Key.End) {
                if (root.visualizer-blocks.length > 0) {
                    root.selected-block-index = root.visualizer-blocks.length - 1;
                    root.block-clicked(root.selected-block-index);
                }
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            padding: 14px;
            spacing: 10px;

            // Top Legend & Density Bar
            HorizontalLayout {
                alignment: space-between;

                HorizontalLayout {
                    spacing: 12px;
                    alignment: center;

                    Text {
                        text: "NVMe Layout (\{root.visualizer-blocks.length} chunks)";
                        font-size: 13px;
                        font-weight: 700;
                        color: Theme.accent-blue;
                        vertical-alignment: center;
                    }

                    LegendBadge {
                        badge-color: #81C784;
                        label: "GDeflate";
                    }

                    LegendBadge {
                        badge-color: #90CAF9;
                        label: "Zstd";
                    }

                    LegendBadge {
                        badge-color: #FFB74D;
                        label: "LZ4";
                    }

                    LegendBadge {
                        badge-color: #AB47BC;
                        label: "rANS";
                    }

                    LegendBadge {
                        badge-color: #E879F9;
                        label: "Brotli-G";
                    }

                    LegendBadge {
                        badge-color: #CFD8DC;
                        label: "Store";
                    }

                    Text {
                        text: "★ = Boot Tail (P0)";
                        font-size: 11px;
                        color: #FBBF24;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: center;

                    ComboBox {
                        width: 170px;
                        model: [
                            "Scale: Auto-Fit (Screen)",
                            "Scale: Micro (8px)",
                            "Scale: Medium (16px)",
                            "Scale: Large (28px)"
                        ];
                        current-index <=> root.density-mode-index;
                    }

                    CheckBox {
                        text: "Color by Partition ID";
                        checked <=> root.map-color-by-partition;
                    }
                }
            }

            // Visualizer Grid Matrix
            Rectangle {
                background: Theme.surface-nested;
                border-radius: 4px;
                border-width: 1px;
                border-color: #24242C;
                vertical-stretch: 1;

                ScrollView {
                    map-matrix-container := Rectangle {
                        property <length> avail-w: max(200px, self.width - 32px);
                        property <length> avail-h: max(200px, parent.height - 32px);
                        property <int> total-n: max(1, root.visualizer-blocks.length);

                        // Dynamic Auto-Fit Pitch Calculation based on screen area
                        property <float> est-pitch-val: Math.sqrt((self.avail-w / 1px) * (self.avail-h / 1px) / self.total-n);
                        property <length> auto-pitch: max(7px, min(36px, self.est-pitch-val * 0.95px));

                        // Active pitch & block dimensions
                        property <length> pitch: root.density-mode-index == 1 ? 9px : (root.density-mode-index == 2 ? 17px : (root.density-mode-index == 3 ? 30px : self.auto-pitch));
                        property <length> block-size: max(5px, self.pitch - (self.pitch > 16px ? 3px : (self.pitch > 9px ? 2px : 1px)));
                        property <int> cols: max(1, Math.floor(self.avail-w / self.pitch));

                        height: max(parent.height, 24px + Math.ceil(root.visualizer-blocks.length / self.cols) * self.pitch);

                        for block[b-idx] in root.visualizer-blocks: Rectangle {
                            x: 14px + Math.mod(b-idx, map-matrix-container.cols) * map-matrix-container.pitch;
                            y: 14px + Math.floor(b-idx / map-matrix-container.cols) * map-matrix-container.pitch;
                            width: map-matrix-container.block-size;
                            height: map-matrix-container.block-size;
                            border-radius: map-matrix-container.block-size > 14px ? 3px : (map-matrix-container.block-size > 7px ? 2px : 1px);
                            background: root.map-color-by-partition ? block.color-part : block.color-algo;
                            border-width: root.selected-block-index == b-idx ? (map-matrix-container.block-size > 12px ? 2px : 1px) : (block-touch.has-hover ? 1px : 0px);
                            border-color: root.selected-block-index == b-idx ? #00E5FF : #FFFFFF;

                            if block.is-boot_tail && map-matrix-container.block-size >= 12px: Rectangle {
                                x: 2px;
                                y: 2px;
                                width: max(3px, map-matrix-container.block-size * 0.25);
                                height: max(3px, map-matrix-container.block-size * 0.25);
                                border-radius: 1px;
                                background: #FBBF24;
                            }

                            block-touch := TouchArea {
                                clicked => {
                                    map-focus-scope.focus();
                                    root.selected-block-index = b-idx;
                                    root.block-clicked(b-idx);
                                }
                            }
                        }
                    }
                }
            }

            // Selected chunk telemetry inspector card
            Rectangle {
                background: Theme.surface-card;
                border-radius: 4px;
                border-width: 1px;
                border-color: Theme.border-card;
                height: 85px;

                if root.selected-block-index >= 0: HorizontalLayout {
                    padding: 12px;
                    spacing: 24px;
                    alignment: space-between;

                    VerticalLayout {
                        alignment: center;
                        spacing: 3px;
                        Text {
                            text: "Asset: " + root.visualizer-blocks[root.selected-block-index].file_name;
                            font-size: 12px;
                            font-weight: 700;
                            color: Theme.accent-cyan;
                            overflow: elide;
                        }

                        Text {
                            text: "Offset in .gdat: " + root.visualizer-blocks[root.selected-block-index].offset_str;
                            font-size: 11px;
                            font-family: "monospace";
                            color: #A7F3D0;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 3px;
                        Text {
                            text: "Uncompressed Size: " + root.visualizer-blocks[root.selected-block-index].size_str;
                            font-size: 11px;
                            color: #D1D5DB;
                        }

                        Text {
                            text: "Compressed Size: " + root.visualizer-blocks[root.selected-block-index].comp_size_str;
                            font-size: 11px;
                            color: #4ADE80;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 3px;
                        Text {
                            text: "Storage Layer: " + root.visualizer-blocks[root.selected-block-index].partition_str;
                            font-size: 11px;
                            font-weight: 700;
                            color: Theme.accent-pink;
                        }

                        Text {
                            text: root.visualizer-blocks[root.selected-block-index].is_boot_tail ? "★ Boot Partition Tier (P0 Instant)" : "GPU Streaming Queue Tier";
                            font-size: 11px;
                            color: root.visualizer-blocks[root.selected-block-index].is_boot_tail ? #FBBF24 : Theme.text-muted;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 3px;
                        Text {
                            text: "Codec: " + root.visualizer-blocks[root.selected-block-index].codec_str;
                            font-size: 11px;
                            color: Theme.accent-blue;
                        }

                        Text {
                            text: "Block #" + (root.selected-block-index + 1) + " of " + root.visualizer-blocks.length;
                            font-size: 11px;
                            color: Theme.text-muted;
                        }
                    }
                }

                if root.selected-block-index < 0: VerticalLayout {
                    alignment: center;
                    Text {
                        text: "Click on any chunk block above or use arrow keys (← ↑ → ↓) to inspect its physical NVMe offset, partition ID, and streaming tier.";
                        font-size: 12px;
                        color: Theme.text-dim;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }
}
