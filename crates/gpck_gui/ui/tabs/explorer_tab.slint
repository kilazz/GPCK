// crates/gpck_gui/ui/tabs/explorer_tab.slint
import {
    ListView,
    ScrollView,
    LineEdit,
    CheckBox,
    ComboBox,
} from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { FileItemUI } from "../types.slint";
import {
    ChannelButton,
    MiniButton,
    ToolbarSeparator,
} from "../components/widgets.slint";

export component ExplorerTab inherits HorizontalLayout {
    in-out property <[FileItemUI]> file-list: [];
    in-out property <int> selected-file-index: -1;
    in-out property <int> sort-column: 0;
    in-out property <bool> sort-ascending: true;
    in-out property <length> table-pane-width: 840px;

    // Inspector and preview
    in-out property <bool> is-preview-loading: false;
    in-out property <bool> show-image: false;
    in-out property <image> preview-image;
    in-out property <string> preview-text: "";
    in-out property <float> preview-zoom: 1.0;
    in-out property <length> preview-offset-x: 0px;
    in-out property <length> preview-offset-y: 0px;

    // Texture preview controls
    in-out property <image> checker-dark-img;
    in-out property <image> checker-light-img;
    in-out property <int> selected-mip-level: 0;
    in-out property <[string]> available-mips: ["Mip 0 (Full)"];
    in-out property <int> bg-mode-index: 0;
    in-out property <int> tonemap-mode-index: 0;
    in-out property <bool> decondition-gacl-preview: true;
    in-out property <bool> reconstruct-normal-z: false;
    in-out property <bool> show-tile-grid: false;

    // RGBA Channel filters
    in-out property <bool> channel-r: true;
    in-out property <bool> channel-g: true;
    in-out property <bool> channel-b: true;
    in-out property <bool> channel-a: true;

    callback sort-column-clicked(int);
    callback file-selected(string);
    callback channel-mask-changed();
    callback mip-level-changed(int);
    callback tonemap-mode-changed(int);
    callback bg-mode-changed(int);
    callback preview-option-toggled();

    padding: 10px;
    spacing: 0px;

    // Left Column: Table of Contents
    Rectangle {
        background: Theme.surface-dark;
        border-radius: 4px;
        border-width: 1px;
        border-color: Theme.border-subtle;
        width: root.table-pane-width;

        focus-scope := FocusScope {
            key-pressed(event) => {
                if (event.text == Key.UpArrow) {
                    if (root.selected-file-index > 0) {
                        root.selected-file-index -= 1;
                        root.file-selected(root.file-list[root.selected-file-index].rel-path);
                    }
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    if (root.selected-file-index < root.file-list.length - 1) {
                        root.selected-file-index += 1;
                        root.file-selected(root.file-list[root.selected-file-index].rel-path);
                    }
                    return accept;
                }
                if (event.text == Key.PageUp) {
                    root.selected-file-index = max(0, root.selected-file-index - 15);
                    if (root.file-list.length > 0) {
                        root.file-selected(root.file-list[root.selected-file-index].rel-path);
                    }
                    return accept;
                }
                if (event.text == Key.PageDown) {
                    root.selected-file-index = min(root.file-list.length - 1, root.selected-file-index + 15);
                    if (root.file-list.length > 0) {
                        root.file-selected(root.file-list[root.selected-file-index].rel-path);
                    }
                    return accept;
                }
                return reject;
            }

            VerticalLayout {
                padding: 10px;
                spacing: 8px;

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Package Contents (\{root.file-list.length} assets)";
                        font-size: 13px;
                        font-weight: 700;
                        color: #D1D5DB;
                        vertical-alignment: center;
                    }

                    LineEdit {
                        width: 220px;
                        placeholder-text: "Search assets...";
                    }
                }

                // Table Header
                Rectangle {
                    background: #23232B;
                    height: 28px;
                    border-radius: 2px;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 2px;

                        TouchArea {
                            width: 25%;
                            clicked => { root.sort-column-clicked(0); }
                            Text {
                                text: "File Path" + (root.sort-column == 0 ? (root.sort-ascending ? " ▲" : " ▼") : "");
                                color: Theme.text-muted;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }

                        TouchArea {
                            width: 12%;
                            clicked => { root.sort-column-clicked(1); }
                            Text {
                                text: "Res / Tiles" + (root.sort-column == 1 ? (root.sort-ascending ? " ▲" : " ▼") : "");
                                color: Theme.text-muted;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }

                        TouchArea {
                            width: 6%;
                            clicked => { root.sort-column-clicked(2); }
                            Text {
                                text: "Fmt" + (root.sort-column == 2 ? (root.sort-ascending ? " ▲" : " ▼") : "");
                                color: Theme.text-muted;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }

                        TouchArea {
                            width: 8%;
                            clicked => { root.sort-column-clicked(3); }
                            Text {
                                text: "Codec" + (root.sort-column == 3 ? (root.sort-ascending ? " ▲" : " ▼") : "");
                                color: Theme.text-muted;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }

                        TouchArea {
                            width: 14%;
                            clicked => { root.sort-column-clicked(4); }
                            Text {
                                text: "GACL" + (root.sort-column == 4 ? (root.sort-ascending ? " ▲" : " ▼") : "");
                                color: Theme.text-muted;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }

                        TouchArea {
                            width: 5%;
                            clicked => { root.sort-column-clicked(5); }
                            Text {
                                text: "Part" + (root.sort-column == 5 ? (root.sort-ascending ? " ▲" : " ▼") : "");
                                color: Theme.text-muted;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }

                        TouchArea {
                            width: 10%;
                            clicked => { root.sort-column-clicked(6); }
                            Text {
                                text: "Queue" + (root.sort-column == 6 ? (root.sort-ascending ? " ▲" : " ▼") : "");
                                color: Theme.text-muted;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        TouchArea {
                            width: 7%;
                            clicked => { root.sort-column-clicked(7); }
                            Text {
                                text: "Orig" + (root.sort-column == 7 ? (root.sort-ascending ? " ▲" : " ▼") : "");
                                color: Theme.text-muted;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }

                        TouchArea {
                            width: 7%;
                            clicked => { root.sort-column-clicked(8); }
                            Text {
                                text: "Comp" + (root.sort-column == 8 ? (root.sort-ascending ? " ▲" : " ▼") : "");
                                color: Theme.text-muted;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }

                        TouchArea {
                            width: 6%;
                            clicked => { root.sort-column-clicked(9); }
                            Text {
                                text: "Ratio" + (root.sort-column == 9 ? (root.sort-ascending ? " ▲" : " ▼") : "");
                                color: Theme.text-muted;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Virtualized ListView (Zero lag on 13,000+ items)
                ListView {
                    for item[index] in root.file-list: Rectangle {
                        height: 24px;
                        background: root.selected-file-index == index ? Theme.surface-selected
                            : row-touch.has-hover ? Theme.surface-hover
                            : (Math.mod(index, 2) == 0 ? Theme.surface-dark : Theme.surface-card);
                        border-radius: 2px;

                        row-touch := TouchArea {
                            clicked => {
                                focus-scope.focus();
                                root.selected-file-index = index;
                                root.file-selected(item.rel-path);
                            }
                        }

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 2px;

                            Text {
                                width: 25%;
                                text: item.rel-path;
                                color: Theme.text-main;
                                font-size: 11px;
                                font-family: "monospace";
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            Text {
                                width: 12%;
                                text: item.res-str;
                                color: item.res-str == "-" ? Theme.text-dim : Theme.accent-cyan;
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            Text {
                                width: 6%;
                                text: item.format-str;
                                color: item.format-str == "GNTC" ? Theme.accent-emerald : (item.format-str == "HIGHMIPS" ? Theme.accent-cyan : (item.format-str == "DDS" ? Theme.accent-blue : #A1A1AA));
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            Text {
                                width: 8%;
                                text: item.method-str;
                                color: item.method-str == "GDeflate" ? #34D399 : (item.method-str == "Zstd" ? #93C5FD : #FCD34D);
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            Text {
                                width: 14%;
                                text: item.gacl-str;
                                color: item.gacl-str == "Raw (None)" || item.gacl-str == "-" ? Theme.text-muted : #FBBF24;
                                font-size: 11px;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            Text {
                                width: 5%;
                                text: item.partition-str;
                                color: item.partition-str == "P0" ? #A78BFA : Theme.accent-pink;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }

                            Text {
                                width: 10%;
                                text: item.queue-str;
                                color: item.queue-str == "Hard (High)" ? Theme.primary-hover : #34D399;
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            Text {
                                width: 7%;
                                text: item.size-str;
                                color: #D1D5DB;
                                font-size: 11px;
                                vertical-alignment: center;
                            }

                            Text {
                                width: 7%;
                                text: item.comp-size-str;
                                color: #D1D5DB;
                                font-size: 11px;
                                vertical-alignment: center;
                            }

                            Text {
                                width: 6%;
                                text: item.ratio-str;
                                color: #4ADE80;
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }

    // Splitter Drag Handle
    Rectangle {
        width: 8px;
        background: splitter-touch.pressed ? Theme.accent-cyan : (splitter-touch.has-hover ? Theme.accent-blue : transparent);

        Rectangle {
            x: 3px;
            width: 2px;
            height: 48px;
            y: (parent.height - self.height) / 2;
            border-radius: 1px;
            background: splitter-touch.has-hover ? Theme.text-bright : #3F3F46;
        }

        splitter-touch := TouchArea {
            mouse-cursor: col-resize;
            moved => {
                root.table-pane-width = max(420px, min(root.width - 380px, root.table-pane-width + (self.mouse-x - self.pressed-x)));
            }
        }
    }

    // Right Column: Inspector and Preview Area
    Rectangle {
        background: Theme.surface-dark;
        border-radius: 4px;
        border-width: 1px;
        border-color: Theme.border-subtle;
        horizontal-stretch: 1;

        VerticalLayout {
            padding: 12px;
            spacing: 10px;

            HorizontalLayout {
                height: 28px;
                alignment: space-between;
                Text {
                    text: "Inspector & Preview";
                    font-size: 13px;
                    font-weight: 700;
                    color: Theme.accent-blue;
                    vertical-alignment: center;
                }

                HorizontalLayout {
                    spacing: 4px;

                    ChannelButton {
                        text: "R";
                        active-bg: #3F1215;
                        active-border: #991B1B;
                        active-text: #FCA5A5;
                        is-active <=> root.channel-r;
                        toggled => { root.channel-mask-changed(); }
                    }

                    ChannelButton {
                        text: "G";
                        active-bg: #0E331B;
                        active-border: #166534;
                        active-text: #86EFAC;
                        is-active <=> root.channel-g;
                        toggled => { root.channel-mask-changed(); }
                    }

                    ChannelButton {
                        text: "B";
                        active-bg: #12224A;
                        active-border: #1E40AF;
                        active-text: #93C5FD;
                        is-active <=> root.channel-b;
                        toggled => { root.channel-mask-changed(); }
                    }

                    ChannelButton {
                        text: "A";
                        active-bg: #27272A;
                        active-border: #52525B;
                        active-text: #F4F4F5;
                        is-active <=> root.channel-a;
                        toggled => { root.channel-mask-changed(); }
                    }

                    ToolbarSeparator { }

                    MiniButton {
                        text: "-";
                        btn-width: 24px;
                        clicked => {
                            root.preview-zoom = max(0.05, root.preview-zoom / 1.25);
                        }
                    }

                    MiniButton {
                        text: "\{round(root.preview-zoom * 100)}%";
                        btn-width: 46px;
                        clicked => {
                            root.preview-zoom = 1.0;
                            root.preview-offset-x = 0px;
                            root.preview-offset-y = 0px;
                        }
                    }

                    MiniButton {
                        text: "+";
                        btn-width: 24px;
                        clicked => {
                            root.preview-zoom = min(32.0, root.preview-zoom * 1.25);
                        }
                    }

                    ToolbarSeparator { }

                    ComboBox {
                        width: 210px;
                        model: root.available-mips;
                        current-index <=> root.selected-mip-level;
                        selected(val) => { root.mip-level-changed(root.selected-mip-level); }
                    }

                    ComboBox {
                        width: 75px;
                        model: ["None", "PBR", "Heatmap", "ACES"];
                        current-index <=> root.tonemap-mode-index;
                        selected(val) => { root.tonemap-mode-changed(root.tonemap-mode-index); }
                    }

                    ComboBox {
                        width: 80px;
                        model: ["Dark Grid", "Light Grid", "Black", "White", "Theme"];
                        current-index <=> root.bg-mode-index;
                        selected(val) => { root.bg-mode-changed(root.bg-mode-index); }
                    }

                    CheckBox {
                        text: "Unshuffle";
                        checked <=> root.decondition-gacl-preview;
                        toggled => { root.preview-option-toggled(); }
                    }

                    CheckBox {
                        text: "Reconstruct Z";
                        checked <=> root.reconstruct-normal-z;
                        toggled => { root.preview-option-toggled(); }
                    }

                    CheckBox {
                        text: "Grid";
                        checked <=> root.show-tile-grid;
                        toggled => { root.preview-option-toggled(); }
                    }
                }
            }

            Rectangle {
                background: root.bg-mode-index == 2 ? #000000 : (root.bg-mode-index == 3 ? #FFFFFF : Theme.surface-nested);
                border-radius: 4px;
                border-width: 1px;
                border-color: #23232B;
                vertical-stretch: 1;
                clip: true;

                if root.show-image && root.bg-mode-index == 0: Image {
                    source: root.checker-dark-img;
                    image-fit: fill;
                    width: 100%;
                    height: 100%;
                }

                if root.show-image && root.bg-mode-index == 1: Image {
                    source: root.checker-light-img;
                    image-fit: fill;
                    width: 100%;
                    height: 100%;
                }

                if root.selected-file-index < 0: VerticalLayout {
                    alignment: center;
                    Text {
                        text: "Select an asset to preview metadata / image / hex dump";
                        color: Theme.text-dim;
                        font-size: 12px;
                        horizontal-alignment: center;
                    }
                }

                if root.selected-file-index >= 0 && root.is-preview-loading: VerticalLayout {
                    alignment: center;
                    Text {
                        text: "Decoding Texture (Native 1:1 Neural Synthesis)...";
                        color: Theme.accent-cyan;
                        font-size: 12px;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }
                }

                if root.selected-file-index >= 0 && !root.is-preview-loading && root.show-image: Rectangle {
                    width: 100%;
                    height: 100%;
                    clip: true;

                    Image {
                        source: root.preview-image;
                        image-fit: contain;
                        x: (parent.width - self.width) / 2 + root.preview-offset-x;
                        y: (parent.height - self.height) / 2 + root.preview-offset-y;
                        width: parent.width * root.preview-zoom;
                        height: parent.height * root.preview-zoom;
                    }

                    image-pan-touch := TouchArea {
                        property <length> start-pan-x: 0px;
                        property <length> start-pan-y: 0px;

                        mouse-cursor: self.pressed ? grabbing : grab;

                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                self.start-pan-x = root.preview-offset-x;
                                self.start-pan-y = root.preview-offset-y;
                            }
                        }

                        moved => {
                            if (self.pressed) {
                                let target-x = self.start-pan-x + (self.mouse-x - self.pressed-x);
                                let target-y = self.start-pan-y + (self.mouse-y - self.pressed-y);

                                let max-pan-x = parent.width * max(1.0, root.preview-zoom * 2.0);
                                let max-pan-y = parent.height * max(1.0, root.preview-zoom * 2.0);

                                root.preview-offset-x = max(-max-pan-x, min(max-pan-x, target-x));
                                root.preview-offset-y = max(-max-pan-y, min(max-pan-y, target-y));
                            }
                        }

                        scroll-event(event) => {
                            if (event.delta-y > 0) {
                                root.preview-zoom = min(32.0, root.preview-zoom * 1.15);
                            } else if (event.delta-y < 0) {
                                root.preview-zoom = max(0.05, root.preview-zoom / 1.15);
                            }
                            return accept;
                        }

                        double-clicked => {
                            root.preview-zoom = 1.0;
                            root.preview-offset-x = 0px;
                            root.preview-offset-y = 0px;
                        }
                    }
                }

                if root.selected-file-index >= 0 && !root.is-preview-loading && !root.show-image: ScrollView {
                    VerticalLayout {
                        padding: 8px;
                        TextInput {
                            text: root.preview-text;
                            read-only: true;
                            single-line: false;
                            wrap: word-wrap;
                            color: #D1D5DB;
                            font-family: "monospace";
                            font-size: 11px;
                        }
                    }
                }
            }
        }
    }
}
