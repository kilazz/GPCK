// crates/gpck_gui/ui/appwindow.slint
import {
    Button,
    CheckBox,
    ComboBox,
    LineEdit,
    Slider,
    ScrollView,
} from "std-widgets.slint";

export struct FileItemUI {
    rel_path: string,
    res_str: string,
    format_str: string,
    method_str: string,
    gacl_str: string,
    partition_str: string,
    queue_str: string,
    size_str: string,
    comp_size_str: string,
    ratio_str: string,
    is_archive: bool,
}

export struct BlockItemUI {
    width: float,
    color_algo: color,
    color_part: color,
    tooltip: string,
    file_name: string,
    offset_str: string,
    size_str: string,
    comp_size_str: string,
    partition_str: string,
    codec_str: string,
    is_boot_tail: bool,
}

component ToolbarSeparator inherits Rectangle {
    width: 1px;
    height: 24px;
    background: #2E2E3A;
    horizontal-stretch: 0;
}

component ToolButton inherits Rectangle {
    in property <string> text;
    in property <bool> is-primary: false;
    in property <length> btn-width: 100px;
    callback clicked();

    width: root.btn-width;
    height: 34px;
    horizontal-stretch: 0;
    border-radius: 5px;
    background: touch.pressed ? (root.is-primary ? #991B1B : #1A1A22)
        : touch.has-hover ? (root.is-primary ? #EF4444 : #32323D)
        : (root.is-primary ? #DC2626 : #23232B);
    border-width: 1px;
    border-color: root.is-primary ? #F87171 : (touch.has-hover ? #4E4E60 : #353542);

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        text: root.text;
        color: root.is-primary ? #FFFFFF : (touch.has-hover ? #FFFFFF : #E4E4E7);
        font-size: 12px;
        font-weight: root.is-primary ? 700 : 500;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

component NavTab inherits Rectangle {
    in property <string> text;
    in property <bool> is-active: false;
    in property <length> tab-width: 80px;
    callback clicked();

    width: root.tab-width;
    height: 34px;
    horizontal-stretch: 0;
    border-radius: 5px;
    background: root.is-active ? #E65A4B
        : touch.has-hover ? #2C2C36
        : #1E1E24;
    border-width: 1px;
    border-color: root.is-active ? #F87171 : (touch.has-hover ? #454556 : #2C2C36);

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        text: root.text;
        color: root.is-active ? #FFFFFF : (touch.has-hover ? #FFFFFF : #9CA3AF);
        font-size: 12px;
        font-weight: root.is-active ? 700 : 500;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

component ChannelButton inherits Rectangle {
    in property <string> text;
    in property <color> active-bg;
    in property <color> active-border;
    in property <color> active-text;
    in-out property <bool> is-active: true;
    callback toggled();

    width: 24px;
    height: 24px;
    border-radius: 4px;
    border-width: 1px;

    background: root.is-active ?
        (touch.pressed ? root.active-bg.darker(20%) : (touch.has-hover ? root.active-bg.brighter(25%) : root.active-bg)) :
        (touch.has-hover ? #27272A : #18181B);

    border-color: root.is-active ?
        (touch.has-hover ? root.active-border.brighter(30%) : root.active-border) :
        (touch.has-hover ? #3F3F46 : #27272A);

    touch := TouchArea {
        clicked => {
            root.is-active = !root.is-active;
            root.toggled();
        }
    }

    Text {
        text: root.text;
        color: root.is-active ? root.active-text : (touch.has-hover ? #A1A1AA : #52525B);
        font-size: 11px;
        font-weight: 700;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

component MiniButton inherits Rectangle {
    in property <string> text;
    in property <length> btn-width: 24px;
    callback clicked();

    width: root.btn-width;
    height: 24px;
    border-radius: 4px;
    border-width: 1px;
    background: touch.pressed ? #27272A : (touch.has-hover ? #3F3F46 : #1E1E24);
    border-color: touch.has-hover ? #52525B : #2D2D38;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        text: root.text;
        color: touch.has-hover ? #FFFFFF : #D1D5DB;
        font-size: 11px;
        font-weight: 700;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

component ModernProgressBar inherits Rectangle {
    in property <float> progress: 0.0;
    in property <color> fill-color: #38BDF8;

    width: 130px;
    height: 6px;
    border-radius: 3px;
    background: #22222A;
    border-width: 1px;
    border-color: #2F2F3D;

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width * max(0.0, min(1.0, root.progress));
        height: parent.height;
        border-radius: 2px;
        background: root.fill-color;
    }
}

component Card inherits Rectangle {
    in property <string> title;
    in property <color> header-color: #60A5FA;

    background: #1E1E24;
    border-radius: 6px;
    border-width: 1px;
    border-color: #2D2D38;

    VerticalLayout {
        padding: 14px;
        spacing: 10px;
        alignment: start;

        Text {
            text: root.title;
            font-size: 12px;
            font-weight: 700;
            color: root.header-color;
        }

        @children
    }
}

component SettingsTab inherits ScrollView {
    in-out property <int> preset-index: 0;
    in-out property <int> method-index: 0;
    in-out property <int> compression-level: 9;
    in-out property <int> partition-size-index: 1;
    in-out property <bool> enable-deduplication: true;
    in-out property <bool> validate-chunks: true;
    in-out property <bool> atg-profile: true;
    in-out property <bool> tiled-streaming-enabled: true;
    in-out property <int> min-tiled-res-index: 0;

    // MiniDXNN Native Neural Textures Properties
    in-out property <bool> ntc-enabled: false;
    in-out property <float> ntc-target-bpp: 5.0;
    in-out property <int> ntc-encoding-index: 0;
    in-out property <int> ntc-grid-res-index: 1;
    in-out property <int> ntc-optimizer-index: 0;
    in-out property <int> ntc-quality-index: 1;
    in-out property <bool> ntc-auto-bundle: true;
    in-out property <bool> ntc-precompute-bc7-modes: true;
    in-out property <bool> ntc-wave-reduced-accum: true;
    in-out property <int> ntc-inference-mode-index: 0;

    // Suffix Rules
    in-out property <string> pbr-suffix-albedo: "_diff, _albedo, _basecolor, _color, _col, _d";
    in-out property <string> pbr-suffix-normal: "_ddn, _ddna, _normal, _norm, _nrm, _n";
    in-out property <string> pbr-suffix-metal: "_spec, _specular, _metal, _metallic, _m";
    in-out property <string> pbr-suffix-rough: "_gloss, _rough, _roughness, _r";
    in-out property <string> pbr-suffix-ao: "_ao, _ambient, _occlusion";
    in-out property <string> pbr-suffix-displ: "_displ, _disp, _height, _h";

    in-out property <bool> gacl-enabled: true;
    in-out property <bool> gacl-auto-mode: true;
    in-out property <int> gacl-bc1-index: 0;
    in-out property <int> gacl-bc2-index: 0;
    in-out property <int> gacl-bc3-index: 0;
    in-out property <int> gacl-bc4-index: 0;
    in-out property <int> gacl-bc5-index: 0;
    in-out property <int> gacl-bc6h-index: 0;
    in-out property <int> gacl-bc7-index: 0;

    in-out property <bool> rdo-enabled: false;
    in-out property <float> rdo-reduction-pct: 5.0;
    in-out property <bool> rdo-use-ycocg: true;
    in-out property <bool> rdo-bc1: true;
    in-out property <bool> rdo-bc2: true;
    in-out property <bool> rdo-bc3: true;
    in-out property <bool> rdo-bc4: false;
    in-out property <bool> rdo-bc5: false;
    in-out property <bool> rdo-bc6h: false;
    in-out property <bool> rdo-bc7: true;

    in-out property <bool> mip-split-enabled: true;
    in-out property <int> max-tail-res-index: 1;

    in-out property <bool> prefer-gpu-decompression: true;
    in-out property <int> staging-buffer-size-index: 2;
    in-out property <int> default-queue-priority-index: 0;

    in-out property <string> encryption-key: "";

    callback preset-selected(int);
    callback run-bench-clicked();
    callback run-custom-bench-clicked();

    property <int> max-compression-level: root.method-index == 1 ? 22 : (root.method-index == 4 ? 11 : (root.method-index == 0 || root.method-index == 2 ? 9 : 1));
    property <bool> is-level-enabled: root.method-index != 5 && root.method-index != 3;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        alignment: start;

        Rectangle {
            background: #1E1E24;
            border-radius: 6px;
            border-width: 1px;
            border-color: #3B82F6;
            height: 44px;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                alignment: space-between;

                Text {
                    text: "Packaging Preset / Quality Profile:";
                    vertical-alignment: center;
                    font-size: 13px;
                    font-weight: 700;
                    color: #60A5FA;
                }

                ComboBox {
                    width: 440px;
                    model: [
                        "GPU Streaming (PC / DirectStorage)",
                        "Next-Gen Neural PBR (MiniDXNN / DP4a / 5 bpp)",
                        "Mobile / Android (ASTC / ETC2 + LZ4)",
                        "Maximum Compression (Distribution)",
                        "Fast Dev Build (Iteration)",
                        "Secure Delivery (Encrypted)",
                        "Custom (User Defined)"
                    ];
                    current-index <=> root.preset-index;
                    selected(val) => {
                        root.preset-selected(root.preset-index);
                    }
                }
            }
        }

        GridLayout {
            spacing: 12px;

            Row {
                Card {
                    title: "[COMPRESSION] Archiving & Compression Engine";
                    header-color: #60A5FA;

                    GridLayout {
                        spacing: 8px;
                        Row {
                            Text {
                                text: "Algorithm:";
                                color: #D1D5DB;
                                font-size: 12px;
                                vertical-alignment: center;
                                width: 130px;
                            }

                            ComboBox {
                                model: ["GDeflate", "Zstd", "LZ4", "rANS", "Brotli-G", "Store"];
                                current-index <=> root.method-index;
                                selected(val) => {
                                    if (root.method-index == 0 && root.compression-level > 9) { root.compression-level = 9; }
                                    if (root.method-index == 2 && root.compression-level > 9) { root.compression-level = 9; }
                                    if (root.method-index == 3) { root.compression-level = 1; }
                                    if (root.method-index == 4 && root.compression-level > 11) { root.compression-level = 11; }
                                    if (root.method-index == 5) { root.compression-level = 0; }
                                }
                            }
                        }

                        Row {
                            Text {
                                text: "Compression Level:";
                                color: #D1D5DB;
                                font-size: 12px;
                                vertical-alignment: center;
                                width: 130px;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                Slider {
                                    minimum: root.method-index == 5 ? 0 : 1;
                                    maximum: root.max-compression-level;
                                    value: root.compression-level;
                                    enabled: root.is-level-enabled;
                                    changed(val) => {
                                        root.compression-level = round(val);
                                    }
                                }

                                Text {
                                    text: root.method-index == 5 ? "Off" : "\{root.compression-level}";
                                    color: root.is-level-enabled ? #FFFFFF : #6B7280;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    width: 24px;
                                }
                            }
                        }

                        Row {
                            Text {
                                text: "Partition Size (NVMe):";
                                color: #D1D5DB;
                                font-size: 12px;
                                vertical-alignment: center;
                                width: 130px;
                            }

                            ComboBox {
                                model: ["32 MB", "64 MB", "128 MB", "256 MB", "512 MB"];
                                current-index <=> root.partition-size-index;
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 6px;
                        CheckBox {
                            text: "Content-Defined Deduplication (XxHash64)";
                            checked <=> root.enable-deduplication;
                        }

                        CheckBox {
                            text: "Validate Chunk Decompression on Pack";
                            checked <=> root.validate-chunks;
                        }

                        CheckBox {
                            text: "Enforce ATG DirectStorage L2/L3 Cache Bounds (256 KB) [Zstd only]";
                            checked <=> root.atg-profile;
                            enabled: root.method-index == 1;
                        }
                    }
                }

                Card {
                    title: "[NEURAL] Hardware GPU Neural Material Engine (MiniDXNN / DP4a)";
                    header-color: #10B981;

                    VerticalLayout {
                        spacing: 8px;

                        HorizontalLayout {
                            alignment: space-between;
                            CheckBox {
                                text: "Enable Neural Textures (MiniDXNN)";
                                checked <=> root.ntc-enabled;
                            }

                            CheckBox {
                                text: "Auto-Bundle PBR Materials";
                                checked <=> root.ntc-auto-bundle;
                                enabled: root.ntc-enabled;
                            }
                        }

                        GridLayout {
                            spacing: 8px;

                            Row {
                                Text {
                                    text: "Input Encoding:";
                                    color: #D1D5DB;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    width: 130px;
                                }

                                ComboBox {
                                    model: [
                                        "Bilinear Grid (Fast & Detailed)",
                                        "Positional Frequencies (Fourier)",
                                        "Identity / Raw Coordinates"
                                    ];
                                    current-index <=> root.ntc-encoding-index;
                                    enabled: root.ntc-enabled;
                                }
                            }

                            Row {
                                Text {
                                    text: "Grid / Latent Density:";
                                    color: #D1D5DB;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    width: 130px;
                                }

                                ComboBox {
                                    model: [
                                        "Grid 64x64 (Fast / ~5.0 bpp)",
                                        "Grid 128x128 (Balanced / ~8.0 bpp)",
                                        "Grid 256x256 (High Quality / ~12.0 bpp)",
                                        "Grid 512x512 (Ultra 4K Crisp / ~16.0 bpp)",
                                        "Grid 1024x1024 (Extreme 4K Native / ~20.0 bpp)"
                                    ];
                                    current-index <=> root.ntc-grid-res-index;
                                    enabled: root.ntc-enabled && root.ntc-encoding-index == 0;
                                }
                            }

                            Row {
                                Text {
                                    text: "GPU Optimizer:";
                                    color: #D1D5DB;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    width: 130px;
                                }

                                ComboBox {
                                    model: [
                                        "Lion (Sign Momentum — Recommended)",
                                        "Adam (Adaptive Moments)",
                                        "SGD (Stochastic Gradient)"
                                    ];
                                    current-index <=> root.ntc-optimizer-index;
                                    enabled: root.ntc-enabled;
                                }
                            }

                            Row {
                                Text {
                                    text: "Training Quality:";
                                    color: #D1D5DB;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    width: 130px;
                                }

                                ComboBox {
                                    model: [
                                        "Fast (10 Epochs / Rapid Preview)",
                                        "Balanced (30 Epochs — Standard)",
                                        "High Quality (100 Epochs)"
                                    ];
                                    current-index <=> root.ntc-quality-index;
                                    enabled: root.ntc-enabled;
                                }
                            }

                            Row {
                                Text {
                                    text: "Inference Target:";
                                    color: #D1D5DB;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    width: 130px;
                                }

                                ComboBox {
                                    model: [
                                        "Universal DP4a (AMD RDNA 2/3, RX6000+, Intel, GeForce)",
                                        "DirectX 12 LinAlg Matrix (SM 6.10)",
                                        "CPU Fallback (SIMD / Multi-Threaded)"
                                    ];
                                    current-index <=> root.ntc-inference-mode-index;
                                    enabled: root.ntc-enabled;
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            CheckBox {
                                text: "Wave-Reduced Bias Accumulation (WaveActiveSum)";
                                checked <=> root.ntc-wave-reduced-accum;
                                enabled: root.ntc-enabled;
                            }

                            CheckBox {
                                text: "Precompute BC7 Mode Bitmaps (<0.05ms Transcode)";
                                checked <=> root.ntc-precompute-bc7-modes;
                                enabled: root.ntc-enabled;
                            }
                        }

                        Rectangle {
                            background: #141417;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: #27272F;

                            VerticalLayout {
                                padding: 10px;
                                spacing: 6px;

                                Text {
                                    text: "Customizable PBR Suffix Rules (CryEngine / Unreal / Unity):";
                                    color: #38BDF8;
                                    font-size: 11px;
                                    font-weight: 700;
                                }

                                GridLayout {
                                    spacing: 6px;

                                    Row {
                                        Text {
                                            text: "Albedo:";
                                            color: #9CA3AF;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                            width: 60px;
                                        }

                                        LineEdit {
                                            text <=> root.pbr-suffix-albedo;
                                            font-size: 11px;
                                        }

                                        Text {
                                            text: "Normal:";
                                            color: #9CA3AF;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                            width: 60px;
                                        }

                                        LineEdit {
                                            text <=> root.pbr-suffix-normal;
                                            font-size: 11px;
                                        }
                                    }

                                    Row {
                                        Text {
                                            text: "Metal/Spec:";
                                            color: #9CA3AF;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                            width: 60px;
                                        }

                                        LineEdit {
                                            text <=> root.pbr-suffix-metal;
                                            font-size: 11px;
                                        }

                                        Text {
                                            text: "Rough/Gloss:";
                                            color: #9CA3AF;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                            width: 60px;
                                        }

                                        LineEdit {
                                            text <=> root.pbr-suffix-rough;
                                            font-size: 11px;
                                        }
                                    }

                                    Row {
                                        Text {
                                            text: "AO:";
                                            color: #9CA3AF;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                            width: 60px;
                                        }

                                        LineEdit {
                                            text <=> root.pbr-suffix-ao;
                                            font-size: 11px;
                                        }

                                        Text {
                                            text: "Displacement:";
                                            color: #9CA3AF;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                            width: 60px;
                                        }

                                        LineEdit {
                                            text <=> root.pbr-suffix-displ;
                                            font-size: 11px;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Row {
                Card {
                    title: "[STREAMING] DDS Texture Streaming & 64KB Sparse Tiles";
                    header-color: #38BDF8;

                    VerticalLayout {
                        spacing: 10px;

                        CheckBox {
                            text: "Enable 64KB Sparse Tile Packaging (Virtual Texturing)";
                            checked <=> root.tiled-streaming-enabled;
                        }

                        CheckBox {
                            text: "Split Mipmaps into Streamable .highmips";
                            checked <=> root.mip-split-enabled;
                            enabled: !root.tiled-streaming-enabled;
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: "Tiling Threshold:";
                                color: #D1D5DB;
                                font-size: 12px;
                                vertical-alignment: center;
                                width: 130px;
                            }

                            ComboBox {
                                model: [
                                    "Auto (2048+)",
                                    "Aggressive (1024+)",
                                    "High-Res (4096+)",
                                    "Off / No Threshold (Tile All)"
                                ];
                                current-index <=> root.min-tiled-res-index;
                                enabled: root.tiled-streaming-enabled;
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: "Max Tail Resolution:";
                                color: #D1D5DB;
                                font-size: 12px;
                                vertical-alignment: center;
                                width: 130px;
                            }

                            ComboBox {
                                model: ["64x64", "128x128", "256x256", "512x512"];
                                current-index <=> root.max-tail-res-index;
                                enabled: root.mip-split-enabled || root.tiled-streaming-enabled;
                            }
                        }

                        Text {
                            text: "64KB Sparse Tiles map 1:1 to D3D12/Vulkan virtual textures for demand-driven Sampler Feedback streaming directly to GPU.";
                            font-size: 11px;
                            color: #9CA3AF;
                            wrap: word-wrap;
                        }
                    }
                }

                Card {
                    title: "[GACL] Texture Conditioning Matrix";
                    header-color: #F59E0B;

                    HorizontalLayout {
                        alignment: space-between;
                        CheckBox {
                            text: "Enable GACL Shuffling";
                            checked <=> root.gacl-enabled;
                        }

                        CheckBox {
                            text: "Auto-Optimizer";
                            checked <=> root.gacl-auto-mode;
                            enabled: root.gacl-enabled;
                        }
                    }

                    GridLayout {
                        spacing: 8px;
                        Row {
                            Text {
                                text: "BC1:";
                                color: #9CA3AF;
                                font-size: 11px;
                                vertical-alignment: center;
                                width: 32px;
                            }

                            ComboBox {
                                model: [
                                    "Auto",
                                    "Disabled (Raw)",
                                    "BC1 Linear (v1)",
                                    "BC1 Linear + Z-Curve",
                                    "BC1 5:6:5 Split (v2)",
                                    "BC1 5:6:5 + Z-Curve"
                                ];
                                current-index <=> root.gacl-bc1-index;
                                enabled: root.gacl-enabled && !root.gacl-auto-mode;
                            }

                            Text {
                                text: "BC5:";
                                color: #9CA3AF;
                                font-size: 11px;
                                vertical-alignment: center;
                                width: 36px;
                            }

                            ComboBox {
                                model: ["Auto", "Disabled (Raw)", "BC5 Dual Channel", "BC5 Dual Channel + Z-Curve"];
                                current-index <=> root.gacl-bc5-index;
                                enabled: root.gacl-enabled && !root.gacl-auto-mode;
                            }
                        }

                        Row {
                            Text {
                                text: "BC2:";
                                color: #9CA3AF;
                                font-size: 11px;
                                vertical-alignment: center;
                                width: 32px;
                            }

                            ComboBox {
                                model: ["Auto", "Disabled (Raw)", "BC2 Alpha Nibble Split"];
                                current-index <=> root.gacl-bc2-index;
                                enabled: root.gacl-enabled && !root.gacl-auto-mode;
                            }

                            Text {
                                text: "BC6H:";
                                color: #9CA3AF;
                                font-size: 11px;
                                vertical-alignment: center;
                                width: 36px;
                            }

                            ComboBox {
                                model: ["Auto", "Disabled (Raw)", "BC6H Header/Index Join"];
                                current-index <=> root.gacl-bc6h-index;
                                enabled: root.gacl-enabled && !root.gacl-auto-mode;
                            }
                        }

                        Row {
                            Text {
                                text: "BC3:";
                                color: #9CA3AF;
                                font-size: 11px;
                                vertical-alignment: center;
                                width: 32px;
                            }

                            ComboBox {
                                model: [
                                    "Auto",
                                    "Disabled (Raw)",
                                    "BC3 Linear (v1)",
                                    "BC3 Linear + Z-Curve",
                                    "BC3 6:6:4 Split (v2)",
                                    "BC3 6:6:4 + Z-Curve"
                                ];
                                current-index <=> root.gacl-bc3-index;
                                enabled: root.gacl-enabled && !root.gacl-auto-mode;
                            }

                            Text {
                                text: "BC7:";
                                color: #9CA3AF;
                                font-size: 11px;
                                vertical-alignment: center;
                                width: 36px;
                            }

                            ComboBox {
                                model: [
                                    "Auto",
                                    "Disabled (Raw)",
                                    "BC7 Mode-Split (3-Stream)",
                                    "BC7 Mode-Join (24-bit)"
                                ];
                                current-index <=> root.gacl-bc7-index;
                                enabled: root.gacl-enabled && !root.gacl-auto-mode;
                            }
                        }

                        Row {
                            Text {
                                text: "BC4:";
                                color: #9CA3AF;
                                font-size: 11px;
                                vertical-alignment: center;
                                width: 32px;
                            }

                            ComboBox {
                                model: ["Auto", "Disabled (Raw)", "BC4 Linear", "BC4 Linear + Z-Curve"];
                                current-index <=> root.gacl-bc4-index;
                                enabled: root.gacl-enabled && !root.gacl-auto-mode;
                            }

                            HorizontalLayout {
                                col: 2;
                                colspan: 2;
                                spacing: 6px;

                                CheckBox {
                                    text: "RDO:";
                                    checked <=> root.rdo-enabled;
                                    enabled: root.gacl-enabled;
                                }

                                Slider {
                                    horizontal-stretch: 1;
                                    minimum: 1;
                                    maximum: 100;
                                    value <=> root.rdo-reduction-pct;
                                    enabled: root.gacl-enabled && root.rdo-enabled;
                                }

                                Text {
                                    text: "\{round(root.rdo-reduction-pct)}%";
                                    color: #FFFFFF;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    width: 28px;
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        alignment: space-between;
                        spacing: 12px;

                        CheckBox {
                            text: "Perceptual YCoCg (Albedo)";
                            checked <=> root.rdo-use-ycocg;
                            enabled: root.gacl-enabled && root.rdo-enabled;
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            Text {
                                text: "Formats:";
                                vertical-alignment: center;
                                color: #9CA3AF;
                                font-size: 11px;
                            }

                            CheckBox {
                                text: "BC1";
                                checked <=> root.rdo-bc1;
                                enabled: root.gacl-enabled && root.rdo-enabled;
                            }

                            CheckBox {
                                text: "BC2";
                                checked <=> root.rdo-bc2;
                                enabled: root.gacl-enabled && root.rdo-enabled;
                            }

                            CheckBox {
                                text: "BC3";
                                checked <=> root.rdo-bc3;
                                enabled: root.gacl-enabled && root.rdo-enabled;
                            }

                            CheckBox {
                                text: "BC4";
                                checked <=> root.rdo-bc4;
                                enabled: root.gacl-enabled && root.rdo-enabled;
                            }

                            CheckBox {
                                text: "BC5";
                                checked <=> root.rdo-bc5;
                                enabled: root.gacl-enabled && root.rdo-enabled;
                            }

                            CheckBox {
                                text: "BC6H";
                                checked <=> root.rdo-bc6h;
                                enabled: root.gacl-enabled && root.rdo-enabled;
                            }

                            CheckBox {
                                text: "BC7";
                                checked <=> root.rdo-bc7;
                                enabled: root.gacl-enabled && root.rdo-enabled;
                            }
                        }
                    }
                }
            }

            Row {
                Card {
                    title: "[GPU] DirectStorage 1.4 & Hardware Offload";
                    header-color: #A855F7;

                    VerticalLayout {
                        spacing: 10px;
                        alignment: start;

                        CheckBox {
                            text: "Direct-to-VRAM GPU Decompression";
                            checked <=> root.prefer-gpu-decompression;
                        }

                        GridLayout {
                            spacing: 8px;
                            Row {
                                Text {
                                    text: "Staging Buffer Size:";
                                    color: #D1D5DB;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    width: 140px;
                                }

                                ComboBox {
                                    model: ["64 MB", "128 MB", "256 MB", "512 MB"];
                                    current-index <=> root.staging-buffer-size-index;
                                }
                            }

                            Row {
                                Text {
                                    text: "Default Queue Priority:";
                                    color: #D1D5DB;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    width: 140px;
                                }

                                ComboBox {
                                    model: ["Normal", "High", "Low"];
                                    current-index <=> root.default-queue-priority-index;
                                }
                            }
                        }

                        Text {
                            text: "DirectStorage bypasses OS page caches and pipes compressed blocks straight into GPU decompression queues.";
                            font-size: 11px;
                            color: #9CA3AF;
                            wrap: word-wrap;
                        }
                    }
                }

                Card {
                    title: "[SECURITY] Metadata Encryption (AES-256-GCM)";
                    header-color: #EF4444;

                    VerticalLayout {
                        spacing: 8px;
                        alignment: start;

                        HorizontalLayout {
                            spacing: 10px;
                            Text {
                                text: "Master Passphrase:";
                                color: #D1D5DB;
                                font-size: 12px;
                                vertical-alignment: center;
                                width: 130px;
                            }

                            LineEdit {
                                placeholder-text: "Leave empty for unencrypted archive";
                                text <=> root.encryption-key;
                            }
                        }

                        Text {
                            text: "Uses PBKDF2-HMAC-SHA256 (100,000 iterations). Encrypts chunk tables and metadata without compromising raw I/O throughput.";
                            font-size: 11px;
                            color: #9CA3AF;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            Row {
                Card {
                    title: "[BENCHMARK] Hardware & Pipeline Diagnostics";
                    header-color: #38BDF8;
                    colspan: 2;

                    VerticalLayout {
                        spacing: 8px;
                        alignment: start;

                        Text {
                            text: "Benchmark memory bandwidth, DirectStorage GPU decompression speed, GACL shuffle transformations, and VFS parallel read rates.";
                            font-size: 11px;
                            color: #9CA3AF;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            Button {
                                text: "Run Full Hardware Benchmark";
                                clicked => { root.run-bench-clicked(); }
                            }

                            Button {
                                text: "Run Custom File Benchmark...";
                                clicked => { root.run-custom-bench-clicked(); }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "GPCK Asset Packaging Toolkit & VFS Studio";
    min-width: 1340px;
    min-height: 800px;
    background: #141417;

    // Master UI State
    in-out property <int> active-tab: 0;
    in-out property <bool> is-processing: false;
    in-out property <float> progress-value: 0.0;
    in-out property <string> status-text: "CPU: Native (Rayon/SIMD) | Vulkan GPU: Ready | DirectStorage: Active";
    in-out property <string> log-text: "> Application initialized.";
    in-out property <string> total-vram-footprint: "0 B";
    in-out property <string> total-disk-footprint: "0 B";
    in-out property <int> selected-file-index: -1;
    in-out property <bool> show-image: false;
    in-out property <image> preview-image;
    in-out property <string> preview-text: "";
    in-out property <bool> is-preview-loading: false;

    // Resizable Splitter State
    in-out property <length> table-pane-width: 840px;

    // Zoom and Pan Viewport State
    in-out property <float> preview-zoom: 1.0;
    in-out property <length> preview-offset-x: 0px;
    in-out property <length> preview-offset-y: 0px;

    // Selected Visualizer Block State for Hardware Inspector
    in-out property <int> selected-block-index: -1;

    // Procedural Checkerboard Images
    in-out property <image> checker-dark-img;
    in-out property <image> checker-light-img;

    // Mipmap & Background & RGBA Channels
    in-out property <int> selected-mip-level: 0;
    in-out property <[string]> available-mips: ["Mip 0 (Full)"];
    in-out property <int> bg-mode-index: 0;

    in-out property <bool> channel-r: true;
    in-out property <bool> channel-g: true;
    in-out property <bool> channel-b: true;
    in-out property <bool> channel-a: true;

    // Sorting & Model
    in-out property <int> sort-column: 0;
    in-out property <bool> sort-ascending: true;
    in-out property <[FileItemUI]> file-list: [];
    in-out property <[BlockItemUI]> visualizer-blocks: [];

    // Settings Bridge Properties
    in-out property <int> preset-index <=> settings-tab.preset-index;
    in-out property <int> method-index <=> settings-tab.method-index;
    in-out property <int> compression-level <=> settings-tab.compression-level;
    in-out property <int> partition-size-index <=> settings-tab.partition-size-index;
    in-out property <bool> enable-deduplication <=> settings-tab.enable-deduplication;
    in-out property <bool> validate-chunks <=> settings-tab.validate-chunks;
    in-out property <bool> atg-profile <=> settings-tab.atg-profile;
    in-out property <bool> tiled-streaming-enabled <=> settings-tab.tiled-streaming-enabled;
    in-out property <int> min-tiled-res-index <=> settings-tab.min-tiled-res-index;

    // MiniDXNN Neural Properties Bridge
    in-out property <bool> ntc-enabled <=> settings-tab.ntc-enabled;
    in-out property <float> ntc-target-bpp <=> settings-tab.ntc-target-bpp;
    in-out property <int> ntc-encoding-index <=> settings-tab.ntc-encoding-index;
    in-out property <int> ntc-grid-res-index <=> settings-tab.ntc-grid-res-index;
    in-out property <int> ntc-optimizer-index <=> settings-tab.ntc-optimizer-index;
    in-out property <int> ntc-quality-index <=> settings-tab.ntc-quality-index;
    in-out property <bool> ntc-auto-bundle <=> settings-tab.ntc-auto-bundle;
    in-out property <bool> ntc-precompute-bc7-modes <=> settings-tab.ntc-precompute-bc7-modes;
    in-out property <bool> ntc-wave-reduced-accum <=> settings-tab.ntc-wave-reduced-accum;
    in-out property <int> ntc-inference-mode-index <=> settings-tab.ntc-inference-mode-index;

    // Suffix Rules Bridge
    in-out property <string> pbr-suffix-albedo <=> settings-tab.pbr-suffix-albedo;
    in-out property <string> pbr-suffix-normal <=> settings-tab.pbr-suffix-normal;
    in-out property <string> pbr-suffix-metal <=> settings-tab.pbr-suffix-metal;
    in-out property <string> pbr-suffix-rough <=> settings-tab.pbr-suffix-rough;
    in-out property <string> pbr-suffix-ao <=> settings-tab.pbr-suffix-ao;
    in-out property <string> pbr-suffix-displ <=> settings-tab.pbr-suffix-displ;

    in-out property <bool> gacl-enabled <=> settings-tab.gacl-enabled;
    in-out property <bool> gacl-auto-mode <=> settings-tab.gacl-auto-mode;
    in-out property <int> gacl-bc1-index <=> settings-tab.gacl-bc1-index;
    in-out property <int> gacl-bc2-index <=> settings-tab.gacl-bc2-index;
    in-out property <int> gacl-bc3-index <=> settings-tab.gacl-bc3-index;
    in-out property <int> gacl-bc4-index <=> settings-tab.gacl-bc4-index;
    in-out property <int> gacl-bc5-index <=> settings-tab.gacl-bc5-index;
    in-out property <int> gacl-bc6h-index <=> settings-tab.gacl-bc6h-index;
    in-out property <int> gacl-bc7-index <=> settings-tab.gacl-bc7-index;

    in-out property <bool> rdo-enabled <=> settings-tab.rdo-enabled;
    in-out property <float> rdo-reduction-pct <=> settings-tab.rdo-reduction-pct;
    in-out property <bool> rdo-use-ycocg <=> settings-tab.rdo-use-ycocg;
    in-out property <bool> rdo-bc1 <=> settings-tab.rdo-bc1;
    in-out property <bool> rdo-bc2 <=> settings-tab.rdo-bc2;
    in-out property <bool> rdo-bc3 <=> settings-tab.rdo-bc3;
    in-out property <bool> rdo-bc4 <=> settings-tab.rdo-bc4;
    in-out property <bool> rdo-bc5 <=> settings-tab.rdo-bc5;
    in-out property <bool> rdo-bc6h <=> settings-tab.rdo-bc6h;
    in-out property <bool> rdo-bc7 <=> settings-tab.rdo-bc7;

    in-out property <bool> mip-split-enabled <=> settings-tab.mip-split-enabled;
    in-out property <int> max-tail-res-index <=> settings-tab.max-tail-res-index;

    in-out property <bool> prefer-gpu-decompression <=> settings-tab.prefer-gpu-decompression;
    in-out property <int> staging-buffer-size-index <=> settings-tab.staging-buffer-size-index;
    in-out property <int> default-queue-priority-index <=> settings-tab.default-queue-priority-index;
    in-out property <string> encryption-key <=> settings-tab.encryption-key;

    in-out property <bool> decondition-gacl-preview: true;
    in-out property <bool> reconstruct-normal-z: false;
    in-out property <bool> show-tile-grid: false;
    in-out property <int> tonemap-mode-index: 0;
    in-out property <bool> raw-extraction-enabled: false;
    in-out property <bool> map-color-by-partition: false;

    // Callbacks to Rust Controller
    callback clear-list-clicked();
    callback add-folder-clicked();
    callback add-files-clicked();
    callback open-archive-clicked();
    callback compress-clicked();
    callback extract-clicked();
    callback verify-clicked();
    callback block-clicked(int);
    callback sort-column-clicked(int);
    callback file-selected(string);
    callback preset-selected(int);
    callback tonemap-mode-changed(int);
    callback bg-mode-changed(int);
    callback channel-mask-changed();
    callback preview-option-toggled();
    callback mip-level-changed(int);
    callback run-bench-clicked();
    callback run-custom-bench-clicked();

    VerticalLayout {
        // Top Toolbar
        Rectangle {
            background: #1A1A1E;
            height: 56px;

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: #27272F;
            }

            HorizontalLayout {
                padding-top: 11px;
                padding-bottom: 11px;
                padding-left: 16px;
                padding-right: 16px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;

                    ToolButton {
                        text: "Open Archive";
                        btn-width: 110px;
                        clicked => { root.open-archive-clicked(); }
                    }

                    ToolButton {
                        text: "Add Folder";
                        btn-width: 95px;
                        clicked => { root.add-folder-clicked(); }
                    }

                    ToolButton {
                        text: "Add Files";
                        btn-width: 90px;
                        clicked => { root.add-files-clicked(); }
                    }

                    ToolbarSeparator { }

                    ToolButton {
                        text: "Clear";
                        btn-width: 70px;
                        clicked => { root.clear-list-clicked(); }
                    }

                    ToolButton {
                        text: "Pack Archive";
                        btn-width: 115px;
                        is-primary: true;
                        clicked => { root.compress-clicked(); }
                    }

                    ToolbarSeparator { }

                    ToolButton {
                        text: "Extract All";
                        btn-width: 95px;
                        clicked => { root.extract-clicked(); }
                    }

                    ToolButton {
                        text: "Verify";
                        btn-width: 75px;
                        clicked => { root.verify-clicked(); }
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;

                    NavTab {
                        text: "Explorer";
                        tab-width: 86px;
                        is-active: root.active-tab == 0;
                        clicked => { root.active-tab = 0; }
                    }

                    NavTab {
                        text: "Map";
                        tab-width: 72px;
                        is-active: root.active-tab == 1;
                        clicked => {
                            root.active-tab = 1;
                            if (root.selected-block-index < 0 && root.visualizer-blocks.length > 0) {
                                root.selected-block-index = 0;
                                root.block-clicked(0);
                            }
                        }
                    }

                    NavTab {
                        text: "Settings";
                        tab-width: 86px;
                        is-active: root.active-tab == 2;
                        clicked => { root.active-tab = 2; }
                    }

                    NavTab {
                        text: "Log";
                        tab-width: 68px;
                        is-active: root.active-tab == 3;
                        clicked => { root.active-tab = 3; }
                    }
                }
            }
        }

        // Main Viewports
        Rectangle {
            background: #141417;

            // ================= 0: Explorer View =================
            if root.active-tab == 0: HorizontalLayout {
                padding: 10px;
                spacing: 0px;

                Rectangle {
                    background: #1A1A1E;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: #27272F;
                    width: root.table-pane-width;

                    focus-scope := FocusScope {
                        key-pressed(event) => {
                            if (event.text == Key.UpArrow) {
                                if (root.selected-file-index > 0) {
                                    root.selected-file-index -= 1;
                                    root.file-selected(root.file-list[root.selected-file-index].rel-path);
                                }
                                return accept;
                            }
                            if (event.text == Key.DownArrow) {
                                if (root.selected-file-index < root.file-list.length - 1) {
                                    root.selected-file-index += 1;
                                    root.file-selected(root.file-list[root.selected-file-index].rel-path);
                                }
                                return accept;
                            }
                            if (event.text == Key.PageUp) {
                                root.selected-file-index = max(0, root.selected-file-index - 10);
                                if (root.file-list.length > 0) {
                                    root.file-selected(root.file-list[root.selected-file-index].rel-path);
                                }
                                return accept;
                            }
                            if (event.text == Key.PageDown) {
                                root.selected-file-index = min(root.file-list.length - 1, root.selected-file-index + 10);
                                if (root.file-list.length > 0) {
                                    root.file-selected(root.file-list[root.selected-file-index].rel-path);
                                }
                                return accept;
                            }
                            return reject;
                        }

                        VerticalLayout {
                            padding: 10px;
                            spacing: 8px;

                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: "Package Contents (\{root.file-list.length} assets)";
                                    font-size: 13px;
                                    font-weight: 700;
                                    color: #D1D5DB;
                                    vertical-alignment: center;
                                }

                                LineEdit {
                                    width: 220px;
                                    placeholder-text: "Search assets...";
                                }
                            }

                            Rectangle {
                                background: #23232B;
                                height: 28px;
                                border-radius: 2px;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 2px;

                                    TouchArea {
                                        width: 25%;
                                        clicked => { root.sort-column-clicked(0); }
                                        Text {
                                            text: "File Path" + (root.sort-column == 0 ? (root.sort-ascending ? " ▲" : " ▼") : "");
                                            color: #9CA3AF;
                                            font-size: 11px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }

                                    TouchArea {
                                        width: 12%;
                                        clicked => { root.sort-column-clicked(1); }
                                        Text {
                                            text: "Res / Tiles" + (root.sort-column == 1 ? (root.sort-ascending ? " ▲" : " ▼") : "");
                                            color: #9CA3AF;
                                            font-size: 11px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }

                                    TouchArea {
                                        width: 6%;
                                        clicked => { root.sort-column-clicked(2); }
                                        Text {
                                            text: "Fmt" + (root.sort-column == 2 ? (root.sort-ascending ? " ▲" : " ▼") : "");
                                            color: #9CA3AF;
                                            font-size: 11px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }

                                    TouchArea {
                                        width: 8%;
                                        clicked => { root.sort-column-clicked(3); }
                                        Text {
                                            text: "Codec" + (root.sort-column == 3 ? (root.sort-ascending ? " ▲" : " ▼") : "");
                                            color: #9CA3AF;
                                            font-size: 11px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }

                                    TouchArea {
                                        width: 14%;
                                        clicked => { root.sort-column-clicked(4); }
                                        Text {
                                            text: "GACL" + (root.sort-column == 4 ? (root.sort-ascending ? " ▲" : " ▼") : "");
                                            color: #9CA3AF;
                                            font-size: 11px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }

                                    TouchArea {
                                        width: 5%;
                                        clicked => { root.sort-column-clicked(5); }
                                        Text {
                                            text: "Part" + (root.sort-column == 5 ? (root.sort-ascending ? " ▲" : " ▼") : "");
                                            color: #9CA3AF;
                                            font-size: 11px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }

                                    TouchArea {
                                        width: 10%;
                                        clicked => { root.sort-column-clicked(6); }
                                        Text {
                                            text: "Queue" + (root.sort-column == 6 ? (root.sort-ascending ? " ▲" : " ▼") : "");
                                            color: #9CA3AF;
                                            font-size: 11px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }

                                    TouchArea {
                                        width: 7%;
                                        clicked => { root.sort-column-clicked(7); }
                                        Text {
                                            text: "Orig" + (root.sort-column == 7 ? (root.sort-ascending ? " ▲" : " ▼") : "");
                                            color: #9CA3AF;
                                            font-size: 11px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }

                                    TouchArea {
                                        width: 7%;
                                        clicked => { root.sort-column-clicked(8); }
                                        Text {
                                            text: "Comp" + (root.sort-column == 8 ? (root.sort-ascending ? " ▲" : " ▼") : "");
                                            color: #9CA3AF;
                                            font-size: 11px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }

                                    TouchArea {
                                        width: 6%;
                                        clicked => { root.sort-column-clicked(9); }
                                        Text {
                                            text: "Ratio" + (root.sort-column == 9 ? (root.sort-ascending ? " ▲" : " ▼") : "");
                                            color: #9CA3AF;
                                            font-size: 11px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            ScrollView {
                                VerticalLayout {
                                    alignment: start;
                                    spacing: 1px;

                                    for item[index] in root.file-list: Rectangle {
                                        height: 24px;
                                        background: root.selected-file-index == index ? #2D3748
                                            : row-touch.has-hover ? #25252E
                                            : (Math.mod(index, 2) == 0 ? #1A1A1E : #1E1E24);
                                        border-radius: 2px;

                                        row-touch := TouchArea {
                                            clicked => {
                                                focus-scope.focus();
                                                root.selected-file-index = index;
                                                root.file-selected(item.rel-path);
                                            }
                                        }

                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 2px;

                                            Text {
                                                width: 25%;
                                                text: item.rel-path;
                                                color: #E4E4E7;
                                                font-size: 11px;
                                                font-family: "monospace";
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }

                                            Text {
                                                width: 12%;
                                                text: item.res-str;
                                                color: item.res-str == "-" ? #6B7280 : #38BDF8;
                                                font-size: 11px;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }

                                            Text {
                                                width: 6%;
                                                text: item.format-str;
                                                color: item.format-str == "GNTC" ? #10B981 : (item.format-str == "HIGHMIPS" ? #38BDF8 : (item.format-str == "DDS" ? #60A5FA : #A1A1AA));
                                                font-size: 11px;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }

                                            Text {
                                                width: 8%;
                                                text: item.method-str;
                                                color: item.method-str == "GDeflate" ? #34D399 : (item.method-str == "Zstd" ? #93C5FD : #FCD34D);
                                                font-size: 11px;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }

                                            Text {
                                                width: 14%;
                                                text: item.gacl-str;
                                                color: item.gacl-str == "Raw (None)" || item.gacl-str == "-" ? #9CA3AF : #FBBF24;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }

                                            Text {
                                                width: 5%;
                                                text: item.partition-str;
                                                color: item.partition-str == "P0" ? #A78BFA : #F472B6;
                                                font-size: 11px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }

                                            Text {
                                                width: 10%;
                                                text: item.queue-str;
                                                color: item.queue-str == "Hard (High)" ? #EF4444 : #34D399;
                                                font-size: 11px;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }

                                            Text {
                                                width: 7%;
                                                text: item.size-str;
                                                color: #D1D5DB;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                            }

                                            Text {
                                                width: 7%;
                                                text: item.comp-size-str;
                                                color: #D1D5DB;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                            }

                                            Text {
                                                width: 6%;
                                                text: item.ratio-str;
                                                color: #4ADE80;
                                                font-size: 11px;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Splitter Handle
                Rectangle {
                    width: 8px;
                    background: splitter-touch.pressed ? #38BDF8 : (splitter-touch.has-hover ? #60A5FA : transparent);

                    Rectangle {
                        x: 3px;
                        width: 2px;
                        height: 48px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 1px;
                        background: splitter-touch.has-hover ? #FFFFFF : #3F3F46;
                    }

                    splitter-touch := TouchArea {
                        mouse-cursor: col-resize;
                        moved => {
                            root.table-pane-width = max(420px, min(root.width - 380px, root.table-pane-width + (self.mouse-x - self.pressed-x)));
                        }
                    }
                }

                // Right Pane: Preview
                Rectangle {
                    background: #1A1A1E;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: #27272F;
                    horizontal-stretch: 1;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 10px;

                        HorizontalLayout {
                            height: 28px;
                            alignment: space-between;
                            Text {
                                text: "Inspector & Preview";
                                font-size: 13px;
                                font-weight: 700;
                                color: #60A5FA;
                                vertical-alignment: center;
                            }

                            HorizontalLayout {
                                spacing: 4px;

                                ChannelButton {
                                    text: "R";
                                    active-bg: #3F1215;
                                    active-border: #991B1B;
                                    active-text: #FCA5A5;
                                    is-active <=> root.channel-r;
                                    toggled => { root.channel-mask-changed(); }
                                }

                                ChannelButton {
                                    text: "G";
                                    active-bg: #0E331B;
                                    active-border: #166534;
                                    active-text: #86EFAC;
                                    is-active <=> root.channel-g;
                                    toggled => { root.channel-mask-changed(); }
                                }

                                ChannelButton {
                                    text: "B";
                                    active-bg: #12224A;
                                    active-border: #1E40AF;
                                    active-text: #93C5FD;
                                    is-active <=> root.channel-b;
                                    toggled => { root.channel-mask-changed(); }
                                }

                                ChannelButton {
                                    text: "A";
                                    active-bg: #27272A;
                                    active-border: #52525B;
                                    active-text: #F4F4F5;
                                    is-active <=> root.channel-a;
                                    toggled => { root.channel-mask-changed(); }
                                }

                                ToolbarSeparator { }

                                MiniButton {
                                    text: "-";
                                    btn-width: 24px;
                                    clicked => {
                                        root.preview-zoom = max(0.05, root.preview-zoom / 1.25);
                                    }
                                }

                                MiniButton {
                                    text: "\{round(root.preview-zoom * 100)}%";
                                    btn-width: 46px;
                                    clicked => {
                                        root.preview-zoom = 1.0;
                                        root.preview-offset-x = 0px;
                                        root.preview-offset-y = 0px;
                                    }
                                }

                                MiniButton {
                                    text: "+";
                                    btn-width: 24px;
                                    clicked => {
                                        root.preview-zoom = min(32.0, root.preview-zoom * 1.25);
                                    }
                                }

                                ToolbarSeparator { }

                                ComboBox {
                                    width: 140px;
                                    model: root.available-mips;
                                    current-index <=> root.selected-mip-level;
                                    selected(val) => { root.mip-level-changed(root.selected-mip-level); }
                                }

                                ComboBox {
                                    width: 75px;
                                    model: ["None", "PBR", "Heatmap", "ACES"];
                                    current-index <=> root.tonemap-mode-index;
                                    selected(val) => { root.tonemap-mode-changed(root.tonemap-mode-index); }
                                }

                                ComboBox {
                                    width: 80px;
                                    model: ["Dark Grid", "Light Grid", "Black", "White", "Theme"];
                                    current-index <=> root.bg-mode-index;
                                    selected(val) => { root.bg-mode-changed(root.bg-mode-index); }
                                }

                                CheckBox {
                                    text: "Unshuffle";
                                    checked <=> root.decondition-gacl-preview;
                                    toggled => { root.preview-option-toggled(); }
                                }

                                CheckBox {
                                    text: "Reconstruct Z";
                                    checked <=> root.reconstruct-normal-z;
                                    toggled => { root.preview-option-toggled(); }
                                }

                                CheckBox {
                                    text: "Grid";
                                    checked <=> root.show-tile-grid;
                                    toggled => { root.preview-option-toggled(); }
                                }
                            }
                        }

                        Rectangle {
                            background: root.bg-mode-index == 2 ? #000000 : (root.bg-mode-index == 3 ? #FFFFFF : #141417);
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: #23232B;
                            vertical-stretch: 1;
                            clip: true;

                            if root.show-image && root.bg-mode-index == 0: Image {
                                source: root.checker-dark-img;
                                image-fit: fill;
                                width: 100%;
                                height: 100%;
                            }

                            if root.show-image && root.bg-mode-index == 1: Image {
                                source: root.checker-light-img;
                                image-fit: fill;
                                width: 100%;
                                height: 100%;
                            }

                            if root.selected-file-index < 0: VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "Select an asset to preview metadata / image / hex dump";
                                    color: #6B7280;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                }
                            }

                            if root.selected-file-index >= 0 && root.is-preview-loading: VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "Decoding Texture (Native 1:1 Neural Synthesis)...";
                                    color: #38BDF8;
                                    font-size: 12px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                }
                            }

                            if root.selected-file-index >= 0 && !root.is-preview-loading && root.show-image: Rectangle {
                                width: 100%;
                                height: 100%;
                                clip: true;

                                Image {
                                    source: root.preview-image;
                                    image-fit: contain;
                                    x: (parent.width - self.width) / 2 + root.preview-offset-x;
                                    y: (parent.height - self.height) / 2 + root.preview-offset-y;
                                    width: parent.width * root.preview-zoom;
                                    height: parent.height * root.preview-zoom;
                                }

                                image-pan-touch := TouchArea {
                                    mouse-cursor: self.pressed ? grabbing : grab;
                                    moved => {
                                        if (self.pressed) {
                                            let max-pan-x = parent.width * max(1.0, root.preview-zoom);
                                            let max-pan-y = parent.height * max(1.0, root.preview-zoom);
                                            root.preview-offset-x = max(-max-pan-x, min(max-pan-x, root.preview-offset-x + (self.mouse-x - self.pressed-x)));
                                            root.preview-offset-y = max(-max-pan-y, min(max-pan-y, root.preview-offset-y + (self.mouse-y - self.pressed-y)));
                                        }
                                    }
                                    scroll-event(event) => {
                                        if (event.delta-y > 0) {
                                            root.preview-zoom = min(32.0, root.preview-zoom * 1.15);
                                        } else if (event.delta-y < 0) {
                                            root.preview-zoom = max(0.05, root.preview-zoom / 1.15);
                                        }
                                        return accept;
                                    }
                                    double-clicked => {
                                        root.preview-zoom = 1.0;
                                        root.preview-offset-x = 0px;
                                        root.preview-offset-y = 0px;
                                    }
                                }
                            }

                            if root.selected-file-index >= 0 && !root.is-preview-loading && !root.show-image: ScrollView {
                                VerticalLayout {
                                    padding: 8px;
                                    TextInput {
                                        text: root.preview-text;
                                        read-only: true;
                                        single-line: false;
                                        wrap: word-wrap;
                                        color: #D1D5DB;
                                        font-family: "monospace";
                                        font-size: 11px;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ================= 1: 2D Memory Map View =================
            if root.active-tab == 1: Rectangle {
                background: #1A1A1E;
                border-radius: 4px;
                border-width: 1px;
                border-color: #27272F;

                map-focus-scope := FocusScope {
                    property <int> cols: Math.max(1, Math.floor((self.width - 48px) / 36px));

                    key-pressed(event) => {
                        if (event.text == Key.LeftArrow) {
                            if (root.selected-block-index > 0) {
                                root.selected-block-index -= 1;
                                root.block-clicked(root.selected-block-index);
                            }
                            return accept;
                        }
                        if (event.text == Key.RightArrow) {
                            if (root.selected-block-index < root.visualizer-blocks.length - 1) {
                                root.selected-block-index += 1;
                                root.block-clicked(root.selected-block-index);
                            }
                            return accept;
                        }
                        if (event.text == Key.UpArrow) {
                            if (root.selected-block-index >= self.cols) {
                                root.selected-block-index -= self.cols;
                                root.block-clicked(root.selected-block-index);
                            }
                            return accept;
                        }
                        if (event.text == Key.DownArrow) {
                            if (root.selected-block-index + self.cols < root.visualizer-blocks.length) {
                                root.selected-block-index += self.cols;
                                root.block-clicked(root.selected-block-index);
                            } else if (root.selected-block-index < root.visualizer-blocks.length - 1) {
                                root.selected-block-index = root.visualizer-blocks.length - 1;
                                root.block-clicked(root.selected-block-index);
                            }
                            return accept;
                        }
                        if (event.text == Key.Home) {
                            root.selected-block-index = 0;
                            if (root.visualizer-blocks.length > 0) {
                                root.block-clicked(0);
                            }
                            return accept;
                        }
                        if (event.text == Key.End) {
                            if (root.visualizer-blocks.length > 0) {
                                root.selected-block-index = root.visualizer-blocks.length - 1;
                                root.block-clicked(root.selected-block-index);
                            }
                            return accept;
                        }
                        return reject;
                    }

                    VerticalLayout {
                        padding: 14px;
                        spacing: 12px;

                        HorizontalLayout {
                            alignment: space-between;

                            HorizontalLayout {
                                spacing: 16px;
                                Text {
                                    text: "VFS Physical Disk Layout (\{root.visualizer-blocks.length} chunks on NVMe)";
                                    font-size: 13px;
                                    font-weight: 700;
                                    color: #60A5FA;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: "Navigate: ← ↑ → ↓ Arrow Keys | ★ = Boot Tail (Partition 0)";
                                    font-size: 11px;
                                    color: #9CA3AF;
                                    vertical-alignment: center;
                                }
                            }

                            CheckBox {
                                text: "Color by NVMe Partition ID";
                                checked <=> root.map-color-by-partition;
                            }
                        }

                        Rectangle {
                            background: #141417;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: #24242C;
                            vertical-stretch: 1;

                            ScrollView {
                                map-matrix-container := Rectangle {
                                    property <int> cols: Math.max(1, Math.floor((self.width - 24px) / 36px));

                                    height: (24px + Math.ceil(root.visualizer-blocks.length / self.cols) * 36px);

                                    for block[b-idx] in root.visualizer-blocks: Rectangle {
                                        x: 12px + Math.mod(b-idx, map-matrix-container.cols) * 36px;
                                        y: 12px + Math.floor(b-idx / map-matrix-container.cols) * 36px;
                                        width: 30px;
                                        height: 30px;
                                        border-radius: 4px;
                                        background: root.map-color-by-partition ? block.color-part : block.color-algo;
                                        border-width: root.selected-block-index == b-idx ? 2px : (block-touch.has-hover ? 1px : 0px);
                                        border-color: root.selected-block-index == b-idx ? #00E5FF : #FFFFFF;

                                        if block.is-boot_tail: Rectangle {
                                            x: 3px;
                                            y: 3px;
                                            width: 6px;
                                            height: 6px;
                                            border-radius: 3px;
                                            background: #FBBF24;
                                        }

                                        block-touch := TouchArea {
                                            clicked => {
                                                map-focus-scope.focus();
                                                root.selected-block-index = b-idx;
                                                root.block-clicked(b-idx);
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            background: #1E1E24;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: #2D2D38;
                            height: 90px;

                            if root.selected-block-index >= 0: HorizontalLayout {
                                padding: 12px;
                                spacing: 24px;
                                alignment: space-between;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Text {
                                        text: "Asset: " + root.visualizer-blocks[root.selected-block-index].file_name;
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: #38BDF8;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: "Physical Offset in .gdat: " + root.visualizer-blocks[root.selected-block-index].offset_str;
                                        font-size: 11px;
                                        font-family: "monospace";
                                        color: #A7F3D0;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Text {
                                        text: "Uncompressed Size: " + root.visualizer-blocks[root.selected-block-index].size_str;
                                        font-size: 11px;
                                        color: #D1D5DB;
                                    }

                                    Text {
                                        text: "Compressed Size: " + root.visualizer-blocks[root.selected-block-index].comp_size_str;
                                        font-size: 11px;
                                        color: #4ADE80;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Text {
                                        text: "Storage Layer: " + root.visualizer-blocks[root.selected-block-index].partition_str;
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: #F472B6;
                                    }

                                    Text {
                                        text: root.visualizer-blocks[root.selected-block-index].is_boot_tail ? "★ Boot Partition Tier (Instant Spawn)" : "GPU Streaming Queue Tier";
                                        font-size: 11px;
                                        color: root.visualizer-blocks[root.selected-block-index].is_boot_tail ? #FBBF24 : #9CA3AF;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Text {
                                        text: "Codec: " + root.visualizer-blocks[root.selected-block-index].codec_str;
                                        font-size: 11px;
                                        color: #60A5FA;
                                    }

                                    Text {
                                        text: "Block #" + (root.selected-block-index + 1) + " of " + root.visualizer-blocks.length;
                                        font-size: 11px;
                                        color: #9CA3AF;
                                    }
                                }
                            }

                            if root.selected-block-index < 0: VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "Click on any chunk block above or use arrow keys (← ↑ → ↓) to inspect its physical NVMe offset, partition ID, and streaming tier.";
                                    font-size: 12px;
                                    color: #6B7280;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            // ================= 2: Settings View =================
            settings-tab := SettingsTab {
                visible: root.active-tab == 2;
                preset-selected(idx) => { root.preset-selected(idx); }
                run-bench-clicked => { root.run-bench-clicked(); }
                run-custom-bench-clicked => { root.run-custom-bench-clicked(); }
            }

            // ================= 3: Log View =================
            if root.active-tab == 3: ScrollView {
                VerticalLayout {
                    padding: 14px;
                    TextInput {
                        text: root.log-text;
                        read-only: true;
                        single-line: false;
                        wrap: word-wrap;
                        color: #A7F3D0;
                        font-family: "monospace";
                        font-size: 12px;
                    }
                }
            }
        }

        // Bottom Status Bar
        Rectangle {
            background: #111113;
            height: 28px;

            Rectangle {
                y: 0px;
                height: 1px;
                background: #222228;
            }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 10px;

                    if root.is-processing: HorizontalLayout {
                        spacing: 8px;

                        VerticalLayout {
                            alignment: center;
                            ModernProgressBar {
                                progress: root.progress-value;
                            }
                        }

                        Text {
                            text: "\{round(root.progress-value * 100)}%";
                            color: #38BDF8;
                            font-size: 10px;
                            font-weight: 700;
                            vertical-alignment: center;
                            width: 28px;
                        }
                    }

                    Text {
                        text: root.status-text;
                        color: #38BDF8;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 16px;
                    Text {
                        text: "VRAM: \{root.total-vram-footprint} | Disk: \{root.total-disk-footprint}";
                        color: #9CA3AF;
                        font-size: 11px;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "Total Items: \{root.file-list.length}";
                        color: #9CA3AF;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
