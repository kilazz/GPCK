[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.2"
reloadable = true

[libraries]
windows.debug.x86_64 = "res://addons/gpck/bin/gpck_godot.dll"
windows.release.x86_64 = "res://addons/gpck/bin/gpck_godot.dll"
linux.debug.x86_64 = "res://addons/gpck/bin/libgpck_godot.so"
linux.release.x86_64 = "res://addons/gpck/bin/libgpck_godot.so"
macos.debug = "res://addons/gpck/bin/libgpck_godot.dylib"
macos.release = "res://addons/gpck/bin/libgpck_godot.dylib"
android.debug.arm64 = "res://addons/gpck/bin/libgpck_godot.so"
android.release.arm64 = "res://addons/gpck/bin/libgpck_godot.so"
